{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS الميكروفون فقط أثناء فتح وضع الصوت. يُحوَّل الصوت إلى نص على الـiPhone أو عبر خدمة Apple للتعرّف على الكلام، ولا يتلقى JARVIS سوى طلباتك نصًا، ولا يتلقى الصوت أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS verwendet das Mikrofon nur, solange der Sprachmodus geöffnet ist. Audio wird auf deinem iPhone oder vom Spracherkennungsdienst von Apple in Text umgewandelt; JARVIS erhält nur deine Anfragen als Text, nie Audio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS uses the microphone only while voice mode is open. Audio is turned into text on your iPhone or by Apple's speech service; JARVIS receives only your requests as text, never audio."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل JARVIS ما تقوله إلى نص: في الطلب الواحد تراجعه قبل الإرسال، وفي المحادثة يُرسَل بعد توقف قصير. عندما تدعم لغتك ذلك يتم التعرّف على الكلام على الـiPhone، وإلا فتعالج خدمة Apple للتعرّف على الكلام الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS wandelt das Gesagte in Text um: Bei einer einzelnen Anfrage prüfst du ihn vor dem Senden, in einem Gespräch wird er nach einer kurzen Pause gesendet. Wenn deine Sprache es unterstützt, erfolgt die Erkennung auf deinem iPhone, sonst verarbeitet der Spracherkennungsdienst von Apple das Audio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS turns what you say into text: for a single request you review it before sending; in a conversation it is sent after a short pause. When your language supports it, recognition happens on your iPhone; otherwise Apple's speech service processes the audio."
          }
        }
      }
    }
  },
  "version": "1.0"
}
