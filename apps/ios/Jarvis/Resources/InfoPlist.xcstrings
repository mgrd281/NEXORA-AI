{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS الميكروفون فقط أثناء نطقك لطلب. يتحوّل الصوت إلى نص على الـ iPhone أو عبر خدمة الكلام من Apple؛ ولا يتلقى JARVIS سوى النص الذي تختار إرساله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS nutzt das Mikrofon nur, während du eine Anfrage sprichst. Der Ton wird auf deinem iPhone oder vom Spracherkennungsdienst von Apple in Text umgewandelt; JARVIS erhält nur den Text, den du senden möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS uses the microphone only while you are speaking a request. Audio is turned into text on your iPhone or by Apple's speech service; JARVIS receives only the text you choose to send."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل JARVIS طلباتك المنطوقة إلى نص لتتمكن من مراجعتها قبل الإرسال. عندما تدعم لغتك ذلك، يتم التعرّف على الـ iPhone؛ وإلا فتعالج خدمة الكلام من Apple الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS wandelt deine gesprochenen Anfragen in Text um, damit du sie vor dem Senden prüfen kannst. Wenn deine Sprache es unterstützt, erfolgt die Erkennung auf deinem iPhone; sonst verarbeitet der Spracherkennungsdienst von Apple den Ton."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS turns your spoken requests into text so you can review them before sending. When your language supports it, recognition happens on your iPhone; otherwise Apple's speech service processes the audio."
          }
        }
      }
    }
  },
  "version": "1.0"
}
