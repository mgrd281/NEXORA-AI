    "Memory is turned off. JARVIS neither reads nor saves memories until you turn it on in JARVIS on the web.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذاكرة متوقفة. لن يقرأ JARVIS الذكريات أو يحفظها حتى تشغّلها من JARVIS على الويب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gedächtnis ist ausgeschaltet. JARVIS liest und speichert keine Erinnerungen, bis du es in JARVIS im Web einschaltest."
