    "Review it on screen and tap Approve or Decline. JARVIS never takes approvals by voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجعها على الشاشة واضغط «موافقة» أو «رفض». لا يقبل JARVIS الموافقات صوتيًا أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe sie auf dem Bildschirm und tippe auf „Freigeben“ oder „Ablehnen“. JARVIS nimmt Freigaben nie per Sprache an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review it on screen and tap Approve or Decline. JARVIS never takes approvals by voice."
          }
        }
      }
    },
