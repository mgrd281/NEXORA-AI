        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person didn't agree to the recording you required, so JARVIS ended the call politely."
          }
        }
      }
    },
    "error.reason.RISK_CRITICAL": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صُنّف هذا الإجراء على أنه بالغ الخطورة، ولا ينفّذ JARVIS مثل هذه الإجراءات أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion ist als kritisch eingestuft, so etwas macht JARVIS nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action is classified as critical risk, which JARVIS never does."
          }
        }
      }
    },
    "error.reason.SCHEDULE_LIMIT_REACHED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك %@ جداول بالفعل، وهو الحد الأقصى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast bereits %@ Zeitpläne, mehr sind nicht möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have %@ schedules, the most you can have."
          }
        }
      }
    },
    "error.reason.SEND_INTERRUPTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بخادم البريد أثناء الإرسال."
          }
