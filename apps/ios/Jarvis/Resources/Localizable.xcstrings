    "error.reason.ATTACHMENT_ENCRYPTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف محمي بكلمة مرور، لذلك لا يستطيع JARVIS قراءته."
          }
        },
        "de": {
          "stringUnit": {
