    },
    "Your session on this iPhone ends and its token is removed from the Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي جلستك على هذا الـ iPhone ويُحذف رمزها من سلسلة المفاتيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung auf diesem iPhone endet und ihr Token wird aus dem Schlüsselbund entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session on this iPhone ends and its token is removed from the Keychain."
          }
        }
      }
    },
    "Your settings don't allow this action.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداداتك لا تسمح بهذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einstellungen erlauben diese Aktion nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings don't allow this action."
          }
        }
      }
    },
    "Your time zone is used for dates and times, for new schedules, and for when your monthly budget resets. The list shows the zones the server accepts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم منطقتك الزمنية للتواريخ والأوقات وللجداول الجديدة ولموعد إعادة تعيين ميزانيتك الشهرية. تعرض القائمة المناطق التي يقبلها الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitzone gilt für Datums- und Zeitangaben, für neue Zeitpläne und dafür, wann dein Monatsbudget zurückgesetzt wird. Die Liste zeigt die Zeitzonen, die der Server akzeptiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your time zone is used for dates and times, for new schedules, and for when your monthly budget resets. The list shows the zones the server accepts."
          }
        }
      }
    },
