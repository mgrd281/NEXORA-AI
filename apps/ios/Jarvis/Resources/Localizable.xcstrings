    "Web access is off, so JARVIS can't read public web pages yet. Turn it on in JARVIS on the web.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الويب متوقف، لذا لا يستطيع JARVIS قراءة صفحات الويب العامة بعد. شغّله من JARVIS على الويب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webzugriff ist aus, daher kann JARVIS noch keine öffentlichen Webseiten lesen. Schalte ihn in JARVIS im Web ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web access is off, so JARVIS can't read public web pages yet. Turn it on in JARVIS on the web."
          }
        }
      }
    },
