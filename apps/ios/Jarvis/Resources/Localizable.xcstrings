          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's AI budget is used up."
          }
        }
      }
    },
    "error.reason.BUDGET_ZERO": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزانيتك الشهرية للذكاء الاصطناعي مضبوطة على 0 دولار."
          }
        },
        "de": {
          "stringUnit": {
