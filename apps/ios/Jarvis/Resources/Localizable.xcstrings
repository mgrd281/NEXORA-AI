            "value": "يجب أن يستخدم عنوان API «%@» بروتوكول HTTPS. لا يُسمح بـ HTTP غير المشفّر إلا لـ localhost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die API-Adresse „%@“ muss HTTPS verwenden. Unverschlüsseltes HTTP ist nur für localhost erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API address “%@” must use HTTPS. Plain HTTP is only allowed for localhost."
          }
        }
      }
    },
