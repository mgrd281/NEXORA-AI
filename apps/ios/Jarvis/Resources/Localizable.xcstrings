    "Ask JARVIS for something on Home and it appears here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب شيئًا من JARVIS في الصفحة الرئيسية وسيظهر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte JARVIS auf der Startseite um etwas – die Aufgabe erscheint dann hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask JARVIS for something on Home and it appears here."
          }
        }
      }
    },
