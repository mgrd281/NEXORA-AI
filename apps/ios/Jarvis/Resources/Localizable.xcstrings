      }
    },
    "error.reason.PURCHASE_LIMIT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتجاوز هذا الشراء (%@) حدك الشهري البالغ %@ (أُنفق %@ بالفعل)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf (%@) würde dein monatliches Limit von %@ überschreiten (%@ schon ausgegeben)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This purchase (%@) would go over your monthly limit of %@ (%@ already spent)."
          }
