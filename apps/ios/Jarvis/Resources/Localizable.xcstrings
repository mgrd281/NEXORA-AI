    "error.reason.PROVIDER_RATE_LIMITED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّ %@ من الطلبات حاليًا. حاول مجددًا بعد بضع دقائق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ begrenzt gerade die Anfragen. Versuche es in ein paar Minuten noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is limiting requests right now. Try again in a few minutes."
          }
