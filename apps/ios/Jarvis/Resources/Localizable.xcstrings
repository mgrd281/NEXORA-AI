          }
        }
      }
    },
    "error.api.FILE_TOO_LARGE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى لحجم الملف %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien dürfen höchstens %@ groß sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files can be at most %@."
          }
        }
      }
    },
    "error.api.INVALID_RECURRENCE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة التكرار هذه غير صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wiederholungsregel ist ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repeat rule isn't valid."
          }
        }
      }
    },
    "error.api.OAUTH_ACCOUNT_MISMATCH": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّلت الدخول بحساب %@ مختلف. افصل الحساب القديم أولًا للتبديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dich mit einem anderen %@-Konto angemeldet. Trenne zuerst das alte, um zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You signed in to a different %@ account. Disconnect the old one first to switch."
          }
        }
      }
    },
    "error.api.OAUTH_DENIED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تسمح بالوصول لدى %@، لذا لم يُربط أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Zugriff bei %@ nicht erlaubt, daher wurde nichts verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You didn't allow access at %@, so nothing was connected."
          }
        }
      }
    },
    "error.api.OAUTH_EXCHANGE_FAILED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُكمل %@ تسجيل الدخول. حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Anmeldung nicht abgeschlossen. Versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't complete the sign-in. Try again."
          }
        }
      }
    },
    "error.api.OAUTH_PENDING_LIMIT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عمليات تسجيل دخول كثيرة ما زالت مفتوحة. أكملها أو انتظر بضع دقائق ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldungen sind noch offen. Schließ sie ab oder warte ein paar Minuten, dann versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-ins are still open. Finish them or wait a few minutes, then try again."
          }
        }
      }
    },
    "error.api.OAUTH_SCOPE_NOT_GRANTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسمح بأي من الأذونات التي طلبها JARVIS، لذا لم يُربط أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine der angefragten Berechtigungen wurde erlaubt, daher wurde nichts verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the permissions JARVIS asked for were allowed, so nothing was connected."
          }
        }
      }
    },
    "error.api.OAUTH_STATE_EXPIRED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق تسجيل الدخول وقتًا طويلًا. ابدأ الاتصال من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hat zu lange gedauert. Starte die Verbindung noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in took too long. Start connecting again."
          }
        }
      }
    },
    "error.api.OAUTH_STATE_INVALID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط تسجيل الدخول هذا لم يعد صالحًا. ابدأ الاتصال من جديد."
          }
        },
        "de": {
          "stringUnit": {
