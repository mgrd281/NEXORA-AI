    "You approved the action": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافقت على الإجراء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Aktion freigegeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You approved the action"
          }
        }
      }
    },
    "You asked for a recording. JARVIS records only if the other person agrees.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبت تسجيل المكالمة. لن يسجّل JARVIS إلا إذا وافق الطرف الآخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast eine Aufzeichnung angefordert. JARVIS zeichnet nur auf, wenn die andere Person zustimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked for a recording. JARVIS records only if the other person agrees."
          }
        }
      }
    },
    "You can allow it in Settings. You can always type your request instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك السماح بذلك من الإعدادات. ويمكنك دائمًا كتابة طلبك بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es in den Einstellungen erlauben. Du kannst deine Anfrage auch jederzeit tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can allow it in Settings. You can always type your request instead."
          }
        }
      }
    },
    "You can allow it in Settings. You can type below in the meantime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك السماح بذلك في الإعدادات. يمكنك الكتابة في الأسفل في هذه الأثناء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das in den Einstellungen erlauben. In der Zwischenzeit kannst du unten schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can allow it in Settings. You can type below in the meantime."
          }
        }
      }
    },
    "You can follow up once the current request has finished.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك المتابعة بعد انتهاء الطلب الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachfragen ist möglich, sobald die aktuelle Anfrage abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can follow up once the current request has finished."
          }
        }
      }
    },
    "You can follow up once “%@” has finished.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك المتابعة بعد انتهاء «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
