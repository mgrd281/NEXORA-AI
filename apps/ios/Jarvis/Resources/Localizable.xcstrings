    "error.reason.PURCHASES_DISABLED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشتريات معطّلة. حدّد حدًا شهريًا للمشتريات في الإعدادات للسماح بها."
          }
        },
        "de": {
