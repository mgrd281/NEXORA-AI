    "error.reason.RECORDING_CONSENT_DECLINED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يوافق الطرف الآخر على التسجيل الذي اشترطته، فأنهى JARVIS المكالمة بلطف."
          }
        },
        "de": {
          "stringUnit": {
