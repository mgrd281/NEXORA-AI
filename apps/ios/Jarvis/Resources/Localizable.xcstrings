    "This server doesn't offer Google or Microsoft connections yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوفر هذا الخادم الاتصال بـ Google أو Microsoft بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
