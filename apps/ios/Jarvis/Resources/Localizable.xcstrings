          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can attach up to %@ files to one request."
          }
        }
      }
    },
    "error.api.UNKNOWN_TIME_ZONE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعرف الخادم هذه المنطقة الزمنية. اختر منطقة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
