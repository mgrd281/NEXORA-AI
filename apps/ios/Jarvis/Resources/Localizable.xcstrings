    "error.reason.BUDGET_EXHAUSTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت ميزانية الذكاء الاصطناعي لهذا الشهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
