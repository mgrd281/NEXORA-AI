        }
      }
    },
    "error.reason.DOCUMENT_NO_TEXT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي المستند على نص يستطيع JARVIS قراءته، لأنه صورة ممسوحة ضوئيًا مثلًا. قراءة الصفحات الممسوحة غير متاحة بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument enthält keinen Text, den JARVIS lesen kann – zum Beispiel, weil es ein Scan ist. Gescannte Seiten zu lesen ist noch nicht möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document has no text JARVIS can read, for example because it is a scan. Reading scanned pages isn't available yet."
          }
        }
      }
    },
