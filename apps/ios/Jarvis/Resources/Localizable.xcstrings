    "error.reason.CONNECTION_MISSING": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج خطوة «%@» إلى اتصال غير مُعدّ أو لا يعمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ braucht eine Verbindung, die nicht eingerichtet ist oder nicht funktioniert."
