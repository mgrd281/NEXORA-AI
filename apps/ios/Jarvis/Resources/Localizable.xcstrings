    "This spends your money. JARVIS always asks, and shows the exact total.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ينفق من مالك. يسأل JARVIS دائمًا ويعرض المبلغ الإجمالي الدقيق."
          }
        },
        "de": {
          "stringUnit": {
