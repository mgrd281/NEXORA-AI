    "Some of this text tries to give instructions to AI assistants. JARVIS doesn't follow it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحاول جزء من هذا النص إعطاء تعليمات لمساعدي الذكاء الاصطناعي. لا يتبعها JARVIS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil dieses Texts versucht, KI-Assistenten Anweisungen zu geben. JARVIS befolgt sie nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of this text tries to give instructions to AI assistants. JARVIS doesn't follow it."
          }
        }
      }
    },
    "Some product text tries to give instructions to AI assistants. JARVIS doesn't follow it.": {
