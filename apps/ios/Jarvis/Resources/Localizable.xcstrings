    "JARVIS isn't configured on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS غير مُهيّأ على هذا الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ist auf diesem iPhone nicht eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS isn't configured on this iPhone."
          }
        }
      }
    },
    "JARVIS needs microphone access to hear your request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج JARVIS إلى الوصول إلى الميكروفون ليسمع طلبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS braucht Zugriff auf das Mikrofon, um deine Anfrage zu hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS needs microphone access to hear your request."
          }
        }
      }
    },
    "JARVIS needs speech recognition access to turn your voice into text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج JARVIS إلى الوصول إلى التعرّف على الكلام لتحويل صوتك إلى نص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS braucht Zugriff auf die Spracherkennung, um deine Stimme in Text umzuwandeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS needs speech recognition access to turn your voice into text."
          }
        }
      }
    },
    "JARVIS performs exactly the action shown": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينفّذ JARVIS الإجراء المعروض تمامًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS führt genau die angezeigte Aktion aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS performs exactly the action shown"
          }
        }
      }
    },
    "JARVIS runs it again from the step that didn't finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد JARVIS تشغيلها بدءًا من الخطوة التي لم تكتمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS führt sie ab dem Schritt erneut aus, der nicht abgeschlossen wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS runs it again from the step that didn't finish."
          }
        }
      }
    },
    "JARVIS sent a response this version of the app can't read. Update the app or try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل JARVIS ردًا لا يستطيع هذا الإصدار من التطبيق قراءته. حدّث التطبيق أو حاول لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat eine Antwort gesendet, die diese App-Version nicht lesen kann. Aktualisiere die App oder versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sent a response this version of the app can't read. Update the app or try again later."
          }
        }
      }
    },
    "JARVIS stops before its next step. Steps that already finished are not undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف JARVIS قبل خطوته التالية. لا يتم التراجع عن الخطوات التي اكتملت بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS stoppt vor dem nächsten Schritt. Bereits abgeschlossene Schritte werden nicht rückgängig gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS stops before its next step. Steps that already finished are not undone."
          }
        }
      }
    },
    "JARVIS took too long to respond. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق JARVIS وقتًا طويلًا للرد. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat zu lange gebraucht. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS took too long to respond. Try again."
          }
        }
      }
    },
    "JARVIS uses the language you choose for it in iOS Settings, so it can differ from your iPhone's language. Tap to change it there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS اللغة التي تختارها له في إعدادات iOS، لذا قد تختلف عن لغة الـ iPhone. اضغط لتغييرها هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS verwendet die Sprache, die du dafür in den iOS-Einstellungen wählst – sie kann von der Sprache deines iPhone abweichen. Tippe, um sie dort zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS uses the language you choose for it in iOS Settings, so it can differ from your iPhone's language. Tap to change it there."
          }
        }
      }
    },
    "JARVIS uses these to personalise its work. Delete anything you don't want it to know.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS هذه المعلومات لتخصيص عمله. احذف أي شيء لا تريده أن يعرفه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS nutzt sie, um seine Arbeit auf dich abzustimmen. Lösche alles, was JARVIS nicht wissen soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS uses these to personalise its work. Delete anything you don't want it to know."
          }
        }
      }
    },
    "JARVIS's background worker isn't responding, so new tasks may wait in the queue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستجيب خدمة JARVIS في الخلفية، لذا قد تنتظر المهام الجديدة في قائمة الانتظار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst von JARVIS antwortet nicht, daher können neue Aufgaben in der Warteschlange warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS's background worker isn't responding, so new tasks may wait in the queue."
          }
        }
      }
    },
