    "No AI model is configured on the server, so JARVIS uses its offline rules engine for simple, well-defined requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد نموذج ذكاء اصطناعي مُهيّأ على الخادم، لذا يستخدم JARVIS محرّك القواعد دون اتصال للطلبات البسيطة والمحدّدة بوضوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server ist kein KI-Modell eingerichtet, daher nutzt JARVIS für einfache, klar umrissene Anfragen seine Offline-Regel-Engine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No AI model is configured on the server, so JARVIS uses its offline rules engine for simple, well-defined requests."
          }
        }
      }
    },
