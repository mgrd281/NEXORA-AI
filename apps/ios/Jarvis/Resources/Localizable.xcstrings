    "This site isn't supported.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الموقع غير مدعوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Website wird nicht unterstützt."
