    "Your monthly AI budget is set to zero.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزانيتك الشهرية للذكاء الاصطناعي مضبوطة على صفر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein monatliches KI-Budget ist auf null gesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your monthly AI budget is set to zero."
          }
        }
      }
    },
    "Your monthly AI budget is used up, so JARVIS uses its offline rules engine until next month.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت ميزانيتك الشهرية للذكاء الاصطناعي، لذا يستخدم JARVIS محرّك القواعد دون اتصال حتى الشهر القادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein monatliches KI-Budget ist aufgebraucht, daher nutzt JARVIS bis zum nächsten Monat seine Offline-Regel-Engine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your monthly AI budget is used up, so JARVIS uses its offline rules engine until next month."
          }
        }
      }
    },
    "Your monthly AI budget is used up.": {
      "localizations": {
        "ar": {
