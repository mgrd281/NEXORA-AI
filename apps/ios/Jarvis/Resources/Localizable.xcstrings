          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is planning"
          }
        }
      }
    },
    "JARVIS is ready": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS جاهز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ist bereit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is ready"
          }
        }
      }
    },
    "JARVIS is running its offline rules engine. It handles simple, well-defined requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل JARVIS بمحرّك القواعد دون اتصال، وهو يتعامل مع الطلبات البسيطة والمحدّدة بوضوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS nutzt seine Offline-Regel-Engine. Sie bearbeitet einfache, klar umrissene Anfragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is running its offline rules engine. It handles simple, well-defined requests."
          }
        }
      }
    },
    "JARVIS is speaking": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS يتحدث"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS spricht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is speaking"
          }
        }
      }
    },
    "JARVIS is using its offline rules engine for simple, well-defined requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS محرّك القواعد دون اتصال للطلبات البسيطة والمحدّدة بوضوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS nutzt für einfache, klar umrissene Anfragen seine Offline-Regel-Engine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is using its offline rules engine for simple, well-defined requests."
          }
        }
      }
    },
    "JARVIS is waiting for your approval": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ينتظر موافقتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS wartet auf deine Freigabe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is waiting for your approval"
          }
        }
      }
    },
    "JARVIS is working": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS يعمل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS arbeitet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is working"
          }
        }
      }
    },
    "JARVIS is working, %@ done": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS يعمل، اكتمل %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS arbeitet, %@ erledigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is working, %@ done"
          }
        }
      }
    },
    "JARVIS isn't configured": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS غير مُهيّأ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ist nicht eingerichtet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS isn't configured"
          }
        }
      }
    },
    "JARVIS isn't configured on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS غير مُهيّأ على هذا الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ist auf diesem iPhone nicht eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS isn't configured on this iPhone."
          }
        }
      }
    },
    "JARVIS isn't watching any email threads. Ask it to tell you when someone replies to a message it sent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتابع JARVIS أي سلسلة رسائل. اطلب منه أن يخبرك عندما يردّ أحد على رسالة أرسلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS beobachtet keine Unterhaltungen. Bitte JARVIS, dir Bescheid zu sagen, wenn jemand auf eine von ihm gesendete Nachricht antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS isn't watching any email threads. Ask it to tell you when someone replies to a message it sent."
          }
        }
      }
    },
    "JARVIS keeps exactly this text. You can delete it in Memory later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ JARVIS بهذا النص كما هو تمامًا، ويمكنك حذفه لاحقًا في الذاكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS behält genau diesen Text. Du kannst ihn später unter „Gedächtnis“ löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS keeps exactly this text. You can delete it in Memory later."
          }
        }
      }
    },
    "JARVIS keeps what was said on each call as text with its task. Audio is kept only when you asked for a recording and the other person agreed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ JARVIS بما قيل في كل مكالمة نصًا مع مهمتها. لا يُحتفظ بالصوت إلا إذا طلبت تسجيلًا ووافق الطرف الآخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS speichert, was bei jedem Anruf gesagt wurde, als Text bei der Aufgabe. Audio wird nur gespeichert, wenn du eine Aufzeichnung angefordert hast und die andere Person zugestimmt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS keeps what was said on each call as text with its task. Audio is kept only when you asked for a recording and the other person agreed."
          }
        }
      }
    },
    "JARVIS keeps working. The latest state appears as soon as the connection is back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل JARVIS العمل. ستظهر آخر حالة فور عودة الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS arbeitet weiter. Der neueste Stand erscheint, sobald die Verbindung wieder da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS keeps working. The latest state appears as soon as the connection is back."
          }
        }
      }
    },
    "JARVIS left that text out of the summary.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبعد JARVIS هذا النص من الملخص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat diesen Text nicht in die Zusammenfassung übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS left that text out of the summary."
          }
        }
      }
    },
    "JARVIS may tell the other person the personal details listed — nothing else.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجوز لـJARVIS أن يذكر للطرف الآخر البيانات الشخصية المدرجة فقط، ولا شيء غيرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS darf der anderen Person die aufgeführten persönlichen Angaben nennen – sonst nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS may tell the other person the personal details listed — nothing else."
          }
        }
      }
    },
    "JARVIS may tell them only these details": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجوز لـJARVIS أن يذكر سوى هذه البيانات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS darf nur diese Angaben nennen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS may tell them only these details"
          }
        }
      }
    },
    "JARVIS needs microphone access to hear you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج JARVIS إلى الوصول إلى الميكروفون ليسمعك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS braucht Zugriff auf das Mikrofon, um dich zu hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS needs microphone access to hear you."
          }
        }
      }
    },
    "JARVIS needs microphone access to hear your request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج JARVIS إلى الوصول إلى الميكروفون ليسمع طلبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS braucht Zugriff auf das Mikrofon, um deine Anfrage zu hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS needs microphone access to hear your request."
          }
        }
      }
    },
    "JARVIS needs speech recognition access to turn your voice into text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج JARVIS إلى الوصول إلى التعرّف على الكلام لتحويل صوتك إلى نص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS braucht Zugriff auf die Spracherkennung, um deine Stimme in Text umzuwandeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS needs speech recognition access to turn your voice into text."
          }
        }
      }
    },
    "JARVIS performs exactly the action shown": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينفّذ JARVIS الإجراء المعروض تمامًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS führt genau die angezeigte Aktion aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS performs exactly the action shown"
          }
        }
      }
    },
    "JARVIS refused something outside what you approved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض JARVIS أمرًا خارج ما وافقت عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat etwas abgelehnt, das nicht freigegeben war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS refused something outside what you approved."
          }
        }
      }
    },
    "JARVIS runs it again from the step that didn't finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد JARVIS تشغيلها بدءًا من الخطوة التي لم تكتمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS führt sie ab dem Schritt erneut aus, der nicht abgeschlossen wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS runs it again from the step that didn't finish."
          }
        }
      }
    },
    "JARVIS says first that it is an AI assistant calling for %@. It approves nothing by voice: only your tap here places the call.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقول JARVIS أولًا إنه مساعد ذكي يتصل نيابةً عن %@. لا يوافق على أي شيء صوتيًا: لمستك هنا وحدها تُجري المكالمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sagt zuerst, dass es ein KI-Assistent ist, der für %@ anruft. Per Sprache wird nichts freigegeben: Nur dein Tippen hier startet den Anruf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS says first that it is an AI assistant calling for %@. It approves nothing by voice: only your tap here places the call."
          }
        }
      }
    },
    "JARVIS sees this conversation's earlier requests and results. It treats results as information, never as instructions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى JARVIS الطلبات والنتائج السابقة في هذه المحادثة، ويتعامل مع النتائج على أنها معلومات لا تعليمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sieht die früheren Anfragen und Ergebnisse dieses Gesprächs. Ergebnisse gelten als Information, nie als Anweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sees this conversation's earlier requests and results. It treats results as information, never as instructions."
          }
        }
      }
    },
    "JARVIS sent a response this version of the app can't read. Update the app or try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل JARVIS ردًا لا يستطيع هذا الإصدار من التطبيق قراءته. حدّث التطبيق أو حاول لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat eine Antwort gesendet, die diese App-Version nicht lesen kann. Aktualisiere die App oder versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sent a response this version of the app can't read. Update the app or try again later."
          }
        }
      }
    },
    "JARVIS speaks for you to someone else on the phone, so it always asks first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحدث JARVIS نيابةً عنك مع شخص آخر عبر الهاتف، لذا يطلب موافقتك دائمًا أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei spricht JARVIS am Telefon für dich mit einer anderen Person, deshalb fragt es immer zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS speaks for you to someone else on the phone, so it always asks first."
          }
        }
      }
    },
    "JARVIS still asks you before every purchase and shows the exact items, total, merchant and delivery. It never buys more than this in a month.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظل JARVIS يسألك قبل كل عملية شراء ويعرض المنتجات والمبلغ الإجمالي والتاجر والتوصيل بدقة. ولن يشتري أبدًا بأكثر من هذا المبلغ في الشهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS fragt dich trotzdem vor jedem Kauf und zeigt die genauen Artikel, den Gesamtbetrag, den Händler und die Lieferung. Es kauft nie mehr als diesen Betrag im Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS still asks you before every purchase and shows the exact items, total, merchant and delivery. It never buys more than this in a month."
          }
        }
      }
    },
    "JARVIS stops before its next step. Steps that already finished are not undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف JARVIS قبل خطوته التالية. لا يتم التراجع عن الخطوات التي اكتملت بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS stoppt vor dem nächsten Schritt. Bereits abgeschlossene Schritte werden nicht rückgängig gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS stops before its next step. Steps that already finished are not undone."
          }
        }
      }
    },
    "JARVIS stops running “%@”. Tasks it already created stay in your history.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوقف JARVIS عن تنفيذ «%@». تبقى المهام التي أنشأها في سجلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS führt „%@“ nicht mehr aus. Bereits erstellte Aufgaben bleiben im Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS stops running “%@”. Tasks it already created stay in your history."
          }
        }
      }
    },
    "JARVIS tells you when someone replies, until %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيخبرك JARVIS عندما يردّ أحد، حتى %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sagt dir bis %@ Bescheid, wenn jemand antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS tells you when someone replies, until %@."
          }
        }
      }
    },
    "JARVIS took too long to respond. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق JARVIS وقتًا طويلًا للرد. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat zu lange gebraucht. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS took too long to respond. Try again."
          }
        }
      }
    },
    "JARVIS used an isolated browser that keeps nothing between visits, and stops at CAPTCHAs and sign-ins instead of working around them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم JARVIS متصفحًا معزولًا لا يحتفظ بشيء بين الزيارات، ويتوقف عند اختبارات CAPTCHA وتسجيلات الدخول بدلًا من التحايل عليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat einen isolierten Browser verwendet, der zwischen Besuchen nichts speichert und bei CAPTCHAs und Anmeldungen anhält, statt sie zu umgehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS used an isolated browser that keeps nothing between visits, and stops at CAPTCHAs and sign-ins instead of working around them."
          }
        }
      }
    },
    "JARVIS uses the language you choose for it in iOS Settings, so it can differ from your iPhone's language. Tap to change it there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS اللغة التي تختارها له في إعدادات iOS، لذا قد تختلف عن لغة الـ iPhone. اضغط لتغييرها هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS verwendet die Sprache, die du dafür in den iOS-Einstellungen wählst – sie kann von der Sprache deines iPhone abweichen. Tippe, um sie dort zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS uses the language you choose for it in iOS Settings, so it can differ from your iPhone's language. Tap to change it there."
          }
        }
      }
    },
    "JARVIS uses these to personalise its work. Delete anything you don't want it to know.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS هذه المعلومات لتخصيص عمله. احذف أي شيء لا تريده أن يعرفه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS nutzt sie, um seine Arbeit auf dich abzustimmen. Lösche alles, was JARVIS nicht wissen soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS uses these to personalise its work. Delete anything you don't want it to know."
          }
        }
      }
    },
    "JARVIS wasn't sure it heard this right and asked again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكن JARVIS متأكدًا من أنه سمع ذلك بشكل صحيح فسأل مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS war nicht sicher, ob es das richtig gehört hat, und hat nachgefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS wasn't sure it heard this right and asked again."
          }
        }
      }
    },
    "JARVIS wasn't sure it understood and asked again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكن JARVIS متأكدًا من أنه فهم فسأل مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS war nicht sicher, ob es das verstanden hat, und hat nachgefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS wasn't sure it understood and asked again."
          }
        }
      }
    },
    "JARVIS will no longer read or change anything in %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يقرأ JARVIS أي شيء في %@ أو يغيّره بعد الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS wird in %@ nichts mehr lesen oder ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS will no longer read or change anything in %@."
          }
        }
      }
    },
    "JARVIS's background worker isn't responding, so new tasks may wait in the queue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستجيب خدمة JARVIS في الخلفية، لذا قد تنتظر المهام الجديدة في قائمة الانتظار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst von JARVIS antwortet nicht, daher können neue Aufgaben in der Warteschlange warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS's background worker isn't responding, so new tasks may wait in the queue."
          }
        }
      }
    },
