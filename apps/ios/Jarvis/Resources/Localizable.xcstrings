    },
    "Signed out on this iPhone. JARVIS couldn't be reached to end the session on the server; it expires on its own, or you can revoke it from another device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل الخروج على هذا الـ iPhone. تعذّر الوصول إلى JARVIS لإنهاء الجلسة على الخادم؛ ستنتهي صلاحيتها تلقائيًا، أو يمكنك إبطالها من جهاز آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone abgemeldet. JARVIS war nicht erreichbar, um die Sitzung auf dem Server zu beenden; sie läuft von selbst ab, oder du widerrufst sie auf einem anderen Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out on this iPhone. JARVIS couldn't be reached to end the session on the server; it expires on its own, or you can revoke it from another device."
          }
        }
      }
    },
