    "JARVIS is running its offline rules engine. It handles simple, well-defined requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل JARVIS بمحرّك القواعد دون اتصال، وهو يتعامل مع الطلبات البسيطة والمحدّدة بوضوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS nutzt seine Offline-Regel-Engine. Sie bearbeitet einfache, klar umrissene Anfragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is running its offline rules engine. It handles simple, well-defined requests."
