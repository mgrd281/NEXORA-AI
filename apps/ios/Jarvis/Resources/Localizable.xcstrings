          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your monthly AI budget is set to $0."
          }
        }
      }
    },
    "error.reason.CALENDAR_CONFLICT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الوقت محجوز بالفعل في تقويمك، لذا لم يُضف JARVIS شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dieser Zeit ist in deinem Kalender schon etwas eingetragen, daher hat JARVIS nichts eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That time is already taken in your calendar, so JARVIS didn't add anything."
          }
        }
      }
    },
    "error.reason.CALL_BUSY": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان الخط مشغولًا. لم يُقل أو يُتفق على شيء. يمكنك المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leitung war besetzt. Es wurde nichts gesagt oder vereinbart. Du kannst es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line was busy. Nothing was said or agreed. You can try again."
          }
        }
      }
    },
    "error.reason.CALL_DECLINED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يرغب الطرف الآخر في التحدث مع مساعد ذكي. لن يعاود JARVIS الاتصال لهذا الغرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die andere Person wollte nicht mit einem KI-Assistenten sprechen. JARVIS ruft dafür nicht erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person didn't want to talk to an AI assistant. JARVIS won't call again for this."
          }
        }
      }
    },
    "error.reason.CALL_DESTINATION_BLOCKED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتصل JARVIS بهذا الرقم: الأرقام ذات التعرفة المرتفعة والبلدان التي لا يتصل بها هذا الخادم محظورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ruft diese Nummer nicht an: Mehrwertnummern und Länder, die dieser Server nicht anruft, sind gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS doesn't call this number: premium-rate numbers and countries this server doesn't call are blocked."
          }
        }
      }
    },
    "error.reason.CALL_DURATION_LIMIT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغت المكالمة أقصى مدة لها (%@) قبل تحقيق الهدف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anruf hat seine Höchstdauer (%@) erreicht, bevor das Ziel erreicht war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call reached its maximum length (%@) before the goal was reached."
          }
        }
      }
    },
    "error.reason.CALL_FAILED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على مزوّد الاتصالات إتمام المكالمة. لم يُقل أو يُتفق على شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Telefonanbieter konnte den Anruf nicht verbinden. Es wurde nichts gesagt oder vereinbart."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone provider couldn't connect the call. Nothing was said or agreed."
          }
        }
      }
    },
    "error.reason.CALL_HUNG_UP": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهى الطرف الآخر المكالمة قبل تحقيق الهدف. لم يُتفق على شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die andere Person hat aufgelegt, bevor das Ziel erreicht war. Es wurde nichts vereinbart."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person hung up before the goal was reached. Nothing was agreed."
          }
        }
      }
    },
    "error.reason.CALL_LIMIT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجرى JARVIS اليوم %@ مكالمات، وهو الحد الأقصى المسموح به. حاول غدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat heute schon %@ Anrufe getätigt, so viele wie erlaubt. Versuch es morgen erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS has made %@ calls today, the most allowed. Try again tomorrow."
          }
        }
      }
    },
    "error.reason.CALL_NO_ANSWER": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يرد أحد. لم يُقل أو يُتفق على شيء. يمكنك المحاولة لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand hat abgenommen. Es wurde nichts gesagt oder vereinbart. Du kannst es später erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody answered. Nothing was said or agreed. You can try again later."
          }
        }
      }
    },
    "error.reason.CALL_OUTSIDE_HOURS": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجري JARVIS المكالمات إلا بين %@ و%@ (%@). حاول مرة أخرى حينها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ruft nur zwischen %@ und %@ (%@) an. Versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS calls only between %@ and %@ (%@). Try again then."
          }
        }
      }
    },
    "error.reason.CALL_STATE_UNKNOWN": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS التأكد مما إذا كانت المكالمة قد أُجريت. قبل الاتصال مجددًا، يسأل مزوّد الاتصالات، فلا تُجرى المكالمة نفسها مرتين أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann nicht feststellen, ob der Anruf aufgebaut wurde. Vor einem neuen Anruf fragt es beim Telefonanbieter nach, damit derselbe Anruf nie zweimal getätigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't tell whether the call was placed. Before calling again, it asks the phone provider, so the same call is never placed twice."
          }
        }
      }
    },
    "error.reason.CALL_VOICEMAIL": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ البريد الصوتي بدلًا من شخص. يمكنك المحاولة لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt einer Person hat eine Mailbox abgenommen. Du kannst es später erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A voicemail answered instead of a person. You can try again later."
          }
        }
      }
    },
    "error.reason.CAPTCHA_DETECTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب %@ إثبات أنك إنسان. لا يحل JARVIS هذه الاختبارات أبدًا: تابع على الموقع بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verlangt einen Nachweis, dass du ein Mensch bist. JARVIS löst so etwas nie: Mach selbst auf der Website weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks to prove you're human. JARVIS never solves these: continue on the site yourself."
          }
        }
      }
    },
    "error.reason.CHECKOUT_UNSUPPORTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS الطلب على %@. سلتك جاهزة هناك: أكمل الشراء بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann auf %@ nicht bestellen. Dein Warenkorb ist dort bereit: Schließ den Kauf selbst ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't order on %@. Your cart is ready there: finish the purchase yourself."
          }
        }
      }
    },
    "error.reason.CONNECTION_EXPIRED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية اتصالك بـ %@. أعد الاتصال ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Verbindung zu %@ ist abgelaufen. Verbinde sie neu und versuche es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ connection has expired. Reconnect it, then retry."
          }
        }
      }
    },
    "error.reason.CONNECTION_MISSING": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج خطوة «%@» إلى اتصال غير مُعدّ أو لا يعمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ braucht eine Verbindung, die nicht eingerichtet ist oder nicht funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” needs a connection that isn't set up or isn't working."
          }
        }
      }
    },
    "error.reason.CONNECTION_SCOPE_MISSING": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يمنح %@ JARVIS هذا الإذن: %@. أعد الاتصال واسمح به ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat JARVIS diese Berechtigung nicht erteilt: %@. Verbinde neu, erlaube sie und versuche es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't given JARVIS this permission: %@. Reconnect and allow it, then retry."
          }
        }
      }
    },
    "error.reason.CONNECT_FAILED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على JARVIS الاتصال بـ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS konnte keine Verbindung zu %@ herstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS couldn't connect to %@."
          }
        }
      }
    },
    "error.reason.DOCUMENT_NO_TEXT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي المستند على نص يستطيع JARVIS قراءته، لأنه صورة ممسوحة ضوئيًا مثلًا. قراءة الصفحات الممسوحة غير متاحة بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument enthält keinen Text, den JARVIS lesen kann – zum Beispiel, weil es ein Scan ist. Gescannte Seiten zu lesen ist noch nicht möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document has no text JARVIS can read, for example because it is a scan. Reading scanned pages isn't available yet."
          }
        }
      }
    },
    "error.reason.DOCUMENT_TOO_MANY_PAGES": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز المستند %@ صفحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument hat mehr als %@ Seiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document has more than %@ pages."
          }
        }
      }
    },
    "error.reason.DO_NOT_CALL": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب صاحب الرقم %@ عدم الاتصال به مجددًا، لذا لن يتصل به JARVIS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte nicht mehr angerufen werden, deshalb ruft JARVIS dort nicht an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asked not to be called again, so JARVIS won't call it."
          }
        }
      }
    },
    "error.reason.EMAIL_NOT_CONNECTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد حساب بريد إلكتروني متصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein E-Mail-Konto verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No email account is connected."
          }
        }
      }
    },
    "error.reason.EMAIL_THREAD_NOT_FOUND": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد سلسلة الرسائل هذه موجودة في بريدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung gibt es in deinem Postfach nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email thread no longer exists in your mailbox."
          }
        }
      }
    },
    "error.reason.EMBEDDED_CREDENTIALS": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي العنوان على اسم مستخدم أو كلمة مرور، لذا لن يفتحه JARVIS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse enthält einen Benutzernamen oder ein Passwort, daher öffnet JARVIS sie nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address contains a user name or password, so JARVIS won't open it."
          }
        }
      }
    },
    "error.reason.EVENT_CHANGED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الحدث بعد أن قرأه JARVIS، لذا لم يُغيَّر شيء. اطلب مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Termin hat sich geändert, nachdem JARVIS ihn gelesen hat, daher wurde nichts geändert. Frag noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event changed after JARVIS read it, so nothing was changed. Ask again."
          }
        }
      }
    },
    "error.reason.EVENT_NOT_FOUND": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا الحدث موجودًا في تقويمك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Termin gibt es in deinem Kalender nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That event no longer exists in your calendar."
          }
        }
      }
    },
    "error.reason.EXTERNAL_MODELS_DISABLED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نماذج الذكاء الاصطناعي الخارجية متوقفة في إعداداتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externe KI-Modelle sind in den Einstellungen ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External AI models are turned off in your settings."
          }
        }
      }
    },
    "error.reason.FETCH_FAILED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading %@ failed."
          }
        }
      }
    },
    "error.reason.FETCH_TIMEOUT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب %@ خلال %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht innerhalb von %@ geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't respond within %@."
          }
        }
      }
    },
    "error.reason.HOST_NOT_FOUND": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر العثور على خادم لـ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ wurde kein Server gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No server could be found for %@."
          }
        }
      }
    },
    "error.reason.HTTP_ERROR": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ %@ برمز HTTP %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat mit HTTP %@ geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ answered with HTTP %@."
          }
        }
      }
    },
    "error.reason.INVALID_PLAN": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطة التي وضعها JARVIS غير صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan von JARVIS war ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan JARVIS made wasn't valid."
          }
        }
      }
    },
    "error.reason.INVALID_RECURRENCE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة تكرار الجدول غير صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederholungsregel des Zeitplans ist ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The schedule's repeat rule isn't valid."
          }
        }
      }
    },
    "error.reason.INVALID_STEP_INPUT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقّت خطوة «%@» مدخلات لا يمكنها استخدامها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat Eingaben erhalten, mit denen der Schritt nichts anfangen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” got input it can't use."
          }
        }
      }
    },
    "error.reason.INVALID_TIME_RANGE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتا البداية والنهاية لا يشكّلان فترة صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginn und Ende ergeben keinen gültigen Zeitraum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start and end times don't make a valid range."
          }
        }
      }
    },
    "error.reason.INVALID_URL": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس عنوان ويب صالحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige Webadresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn't a valid web address."
          }
        }
      }
    },
    "error.reason.LOGIN_REQUIRED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب %@ تسجيل الدخول. لا يسجّل JARVIS الدخول نيابةً عنك: تابع على الموقع بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verlangt eine Anmeldung. JARVIS meldet sich nicht für dich an: Mach selbst auf der Website weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs you to sign in. JARVIS doesn't sign in for you: continue on the site yourself."
          }
        }
      }
    },
    "error.reason.MEMORY_DISABLED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذاكرة متوقفة في إعدادات الخصوصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gedächtnis ist in deinen Datenschutzeinstellungen ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory is turned off in your privacy settings."
          }
        }
      }
    },
    "error.reason.MEMORY_TOO_LONG": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يتجاوز طول الملاحظة %@ حرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Notiz darf höchstens %@ Zeichen lang sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A note can be at most %@ characters long."
          }
        }
      }
    },
    "error.reason.MISSING_CONTENT_TYPE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحدّد الخادم نوع المحتوى الذي أرسله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht angegeben, welche Art von Inhalt er sendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't say what kind of content it sent."
          }
        }
      }
    },
    "error.reason.MISSING_HOST": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي العنوان على اسم مضيف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Adresse fehlt der Hostname."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address has no host name."
          }
        }
      }
    },
    "error.reason.MODEL_UNAVAILABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتوفر نموذج ذكاء اصطناعي على هذا الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Server ist kein KI-Modell verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No AI model is available on this server."
          }
        }
      }
    },
    "error.reason.NAVIGATION_BLOCKED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول الموقع توجيه JARVIS إلى %@، وهذا غير مسموح، لذا توقف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Website wollte JARVIS zu %@ führen. Das ist nicht erlaubt, daher wurde abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The site tried to lead JARVIS to %@, which isn't allowed, so it stopped."
          }
        }
      }
    },
    "error.reason.NOTHING_TO_RECALL": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد نتيجة سابقة في هذه المحادثة يمكن استخدامها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Gespräch gibt es kein früheres Ergebnis, das sich verwenden lässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no earlier result in this conversation to use."
          }
        }
      }
    },
    "error.reason.NO_FREE_SLOTS": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد وقت متاح في هذه الفترة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Zeitraum ist keine Zeit frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no free time in that window."
          }
        }
      }
    },
    "error.reason.NO_READABLE_TEXT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي الصفحة على نص قابل للقراءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite enthält keinen lesbaren Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page has no readable text."
          }
        }
      }
    },
    "error.reason.NO_TOOLS": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر أي من الأدوات التي يتطلبها هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keines der dafür nötigen Werkzeuge ist verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the tools this needs are available."
          }
        }
      }
    },
    "error.reason.NUMBER_NOT_LITERAL": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتصل JARVIS إلا بالأرقام التي تكتبها بنفسك. اكتب الرقم مع رمز الدولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ruft nur Nummern an, die du selbst schreibst. Schreib die Nummer mit Ländervorwahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS calls only numbers you write yourself. Write the number with its country code."
          }
        }
      }
    },
    "error.reason.OFFLINE_UNSUPPORTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دون نموذج ذكاء اصطناعي، لا يفهم JARVIS إلا أنواعًا قليلة من الطلبات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne KI-Modell versteht JARVIS nur wenige Arten von Anfragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an AI model, JARVIS understands only a few kinds of requests."
          }
        }
      }
    },
    "error.reason.ORDER_UNKNOWN": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الطلب أثناء تقديمه. تحقق من طلباتك لدى المتجر قبل المحاولة مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bestellung wurde beim Absenden unterbrochen. Prüf deine Bestellungen beim Shop, bevor du es noch einmal versuchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The order was interrupted while it was being placed. Check your orders with the shop before trying again."
          }
        }
      }
    },
    "error.reason.OUT_OF_STOCK": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنتج غير متوفر، لذا لم يُطلب شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Artikel ist nicht vorrätig, daher wurde nichts bestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's out of stock, so nothing was ordered."
          }
        }
      }
    },
    "error.reason.PAGE_CHANGED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو %@ مختلفًا عمّا يتوقعه JARVIS، لذا توقف بدلًا من التخمين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sieht anders aus, als JARVIS erwartet, daher wurde abgebrochen statt zu raten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ looks different than JARVIS expects, so it stopped rather than guess."
          }
        }
      }
    },
    "error.reason.PAGE_TOO_LARGE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الصفحة أكبر من %@ ميغابايت."
          }
