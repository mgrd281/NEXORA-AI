    "Web access is off, so JARVIS can't read public web pages yet. Turn it on in JARVIS on the web.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الويب متوقف، لذا لا يستطيع JARVIS قراءة صفحات الويب العامة بعد. شغّله من JARVIS على الويب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webzugriff ist aus, daher kann JARVIS noch keine öffentlichen Webseiten lesen. Schalte ihn in JARVIS im Web ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web access is off, so JARVIS can't read public web pages yet. Turn it on in JARVIS on the web."
          }
        }
      }
    },
    "What should JARVIS do?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تريد أن يفعل JARVIS؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll JARVIS tun?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should JARVIS do?"
          }
        }
      }
    },
    "What should JARVIS remember?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تريد أن يتذكر JARVIS؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll sich JARVIS merken?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should JARVIS remember?"
          }
        }
      }
    },
    "Why JARVIS is asking": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا يسأل JARVIS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum JARVIS fragt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why JARVIS is asking"
          }
        }
      }
    },
    "Working": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working"
          }
        }
      }
    },
    "Working · %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل · %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitet · %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working · %@"
          }
        }
      }
    },
    "You approved the action": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافقت على الإجراء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Aktion freigegeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You approved the action"
          }
        }
      }
    },
    "You can allow it in Settings. You can always type your request instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك السماح بذلك من الإعدادات. ويمكنك دائمًا كتابة طلبك بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es in den Einstellungen erlauben. Du kannst deine Anfrage auch jederzeit tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can allow it in Settings. You can always type your request instead."
          }
        }
      }
    },
    "You declined the action": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت الإجراء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Aktion abgelehnt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You declined the action"
          }
        }
      }
    },
    "You don't have permission to do that.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لديك إذن للقيام بذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür hast du keine Berechtigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do that."
          }
        }
      }
    },
    "You turned off external AI models, so JARVIS uses its offline rules engine for simple, well-defined requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أوقفت نماذج الذكاء الاصطناعي الخارجية، لذا يستخدم JARVIS محرّك القواعد دون اتصال للطلبات البسيطة والمحدّدة بوضوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast externe KI-Modelle ausgeschaltet, daher nutzt JARVIS für einfache, klar umrissene Anfragen seine Offline-Regel-Engine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You turned off external AI models, so JARVIS uses its offline rules engine for simple, well-defined requests."
          }
        }
      }
    },
    "You're offline. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل بالإنترنت. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Check your connection and try again."
          }
        }
      }
    },
    "Your JARVIS session has ended. Sign in again in the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلستك في JARVIS. سجّل الدخول مرة أخرى في التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine JARVIS-Sitzung ist beendet. Melde dich in der App erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your JARVIS session has ended. Sign in again in the app."
          }
        }
      }
    },
    "Your monthly AI budget is set to zero.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزانيتك الشهرية للذكاء الاصطناعي مضبوطة على صفر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein monatliches KI-Budget ist auf null gesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your monthly AI budget is set to zero."
          }
        }
      }
    },
    "Your monthly AI budget is used up, so JARVIS uses its offline rules engine until next month.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت ميزانيتك الشهرية للذكاء الاصطناعي، لذا يستخدم JARVIS محرّك القواعد دون اتصال حتى الشهر القادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein monatliches KI-Budget ist aufgebraucht, daher nutzt JARVIS bis zum nächsten Monat seine Offline-Regel-Engine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your monthly AI budget is used up, so JARVIS uses its offline rules engine until next month."
          }
        }
      }
    },
    "Your monthly AI budget is used up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت ميزانيتك الشهرية للذكاء الاصطناعي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein monatliches KI-Budget ist aufgebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your monthly AI budget is used up."
          }
        }
      }
    },
    "Your personal agent. It asks before it acts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وكيلك الشخصي. يسأل قبل أن يتصرّف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein persönlicher Agent. Er fragt, bevor er handelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal agent. It asks before it acts."
          }
        }
      }
    },
