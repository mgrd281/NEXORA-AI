    "error.reason.PRICE_CHANGED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر السعر من %@ إلى %@، لذا لم يُطلب شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Preis hat sich von %@ auf %@ geändert, daher wurde nichts bestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price changed from %@ to %@, so nothing was ordered."
