    "“%@” needs your approval. Open JARVIS to review it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» بحاجة إلى موافقتك. افتح JARVIS لمراجعتها."
