    "Add facts and preferences you want JARVIS to keep in mind.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف حقائق وتفضيلات تريد أن يتذكرها JARVIS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Fakten und Vorlieben hinzu, die JARVIS sich merken soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add facts and preferences you want JARVIS to keep in mind."
          }
        }
      }
    },
    "Add memory": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة ذكرى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung hinzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add memory"
          }
        }
      }
    },
    "Add, move and cancel events and send invitations, each time after you approve the change.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة المواعيد ونقلها وإلغاؤها وإرسال الدعوات، في كل مرة بعد موافقتك على التغيير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine anlegen, verschieben und absagen und Einladungen senden – jedes Mal erst nach deiner Freigabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add, move and cancel events and send invitations, each time after you approve the change."
          }
        }
      }
    },
