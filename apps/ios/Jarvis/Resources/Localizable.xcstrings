    },
    "JARVIS is placing this order. It counts against your monthly purchase limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقدّم JARVIS هذا الطلب الآن. ويُحتسب ضمن حدك الشهري للمشتريات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS gibt diese Bestellung gerade auf. Sie zählt zu deinem monatlichen Kauflimit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is placing this order. It counts against your monthly purchase limit."
          }
        }
      }
    },
    "JARVIS is planning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS يخطّط"
          }
        },
        "de": {
