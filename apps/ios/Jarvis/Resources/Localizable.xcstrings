            "state": "translated",
            "value": "The site needed more steps than JARVIS allows (%@), so it stopped."
          }
        }
      }
    },
    "error.reason.BROWSER_CRASHED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
