          "stringUnit": {
            "state": "translated",
            "value": "وكيل المتصفح لا يعمل على هذا الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Browser-Agent läuft auf diesem Server nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser agent isn't running on this server."
          }
        }
      }
    },
    "The browser stopped mid-way. If this step submits something, JARVIS can't tell whether it went through.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف المتصفح في منتصف الطريق. إذا كانت هذه الخطوة ترسل شيئًا، فلا يستطيع JARVIS معرفة ما إذا وصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Browser wurde mittendrin beendet. Wenn dieser Schritt etwas absendet, kann JARVIS nicht sagen, ob es angekommen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser stopped mid-way. If this step submits something, JARVIS can't tell whether it went through."
          }
        }
      }
    },
    "The browser stopped unexpectedly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف المتصفح على نحو غير متوقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Browser hat unerwartet angehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser stopped unexpectedly."
          }
        }
      }
    },
    "The call didn't get as far as JARVIS's introduction.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تصل المكالمة إلى تعريف JARVIS بنفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anruf kam nicht bis zur Vorstellung von JARVIS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call didn't get as far as JARVIS's introduction."
          }
        }
      }
    },
    "The call didn't go through": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم المكالمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anruf kam nicht zustande"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call didn't go through"
          }
        }
      }
    },
    "The call didn't reach its goal.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تحقق المكالمة هدفها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anruf hat sein Ziel nicht erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call didn't reach its goal."
          }
        }
      }
    },
    "The call reached its maximum length.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغت المكالمة أقصى مدة لها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anruf hat seine Höchstdauer erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call reached its maximum length."
          }
        }
      }
    },
    "The chosen voice isn't on this iPhone, so the system voice is used.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصوت المختار غير موجود على هذا الـiPhone، لذا يُستخدم صوت النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählte Stimme ist auf diesem iPhone nicht vorhanden, daher wird die Systemstimme verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen voice isn't on this iPhone, so the system voice is used."
          }
        }
      }
    },
    "The connection doesn't allow this yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمح الاتصال بهذا بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung erlaubt das noch nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection doesn't allow this yet."
          }
        }
      }
    },
    "The connection it needs has expired. Reconnect it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الاتصال المطلوب. أعد الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nötige Verbindung ist abgelaufen. Verbinde sie neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection it needs has expired. Reconnect it."
          }
        }
      }
    },
    "The connection stopped working or the thread is gone, so JARVIS stopped checking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف الاتصال عن العمل أو اختفت سلسلة الرسائل، لذا توقف JARVIS عن التحقق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung funktioniert nicht mehr oder die Unterhaltung ist weg, daher prüft JARVIS nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection stopped working or the thread is gone, so JARVIS stopped checking."
          }
        }
      }
    },
    "The connection works again, so you can retry them now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاد الاتصال للعمل، فيمكنك إعادة محاولتها الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung funktioniert wieder, du kannst sie jetzt wiederholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection works again, so you can retry them now."
          }
        }
      }
    },
    "The email goes only to your own address.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل الرسالة إلى عنوانك فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail geht nur an deine eigene Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The email goes only to your own address."
          }
        }
      }
    },
    "The event being cancelled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموعد الذي سيُلغى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der abgesagte Termin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event being cancelled"
          }
        }
      }
    },
    "The file is too large.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف كبير جدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist zu groß."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large."
          }
        }
      }
    },
    "The form receives": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتلقى النموذج"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Formular erhält"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The form receives"
          }
        }
      }
    },
    "The last attempt may have worked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما نجحت المحاولة الأخيرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Versuch war vielleicht erfolgreich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last attempt may have worked"
          }
        }
      }
    },
    "The lines below; JARVIS may also answer questions within this purpose and the details listed. It never agrees to anything else or shares anything else.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجمل أدناه، ويجوز لـJARVIS أيضًا الإجابة عن أسئلة في حدود هذا الغرض والبيانات المدرجة. لا يوافق أبدًا على أي شيء آخر ولا يشارك أي شيء آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sätze unten; JARVIS darf außerdem Fragen im Rahmen dieses Zwecks und der aufgeführten Angaben beantworten. Es sagt nie etwas anderem zu und gibt nichts anderes weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lines below; JARVIS may also answer questions within this purpose and the details listed. It never agrees to anything else or shares anything else."
          }
        }
      }
    },
    "The microphone couldn't be started. Close other apps that are recording and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تشغيل الميكروفون. أغلق التطبيقات الأخرى التي تسجّل وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon konnte nicht gestartet werden. Schließe andere Apps, die aufnehmen, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone couldn't be started. Close other apps that are recording and try again."
          }
        }
      }
    },
    "The most JARVIS may spend on purchases in a calendar month of your time zone. Orders being placed, placed, or with an unknown outcome count against it. Purchases in other currencies are refused, and every purchase still needs your approval of the exact items and total.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقصى ما يمكن لـ JARVIS إنفاقه على المشتريات خلال شهر تقويمي بتوقيتك. تُحتسب ضمنه الطلبات قيد التقديم والمقدَّمة وتلك ذات النتيجة غير المعروفة. تُرفض المشتريات بعملات أخرى، وتظل كل عملية شراء بحاجة إلى موافقتك على المنتجات والمبلغ الإجمالي بدقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Höchstbetrag, den JARVIS in einem Kalendermonat deiner Zeitzone für Käufe ausgeben darf. Bestellungen, die gerade aufgegeben werden, aufgegeben sind oder deren Ausgang unbekannt ist, zählen dazu. Käufe in anderen Währungen werden abgelehnt, und jeder Kauf braucht weiterhin deine Freigabe der genauen Artikel und des Gesamtbetrags."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most JARVIS may spend on purchases in a calendar month of your time zone. Orders being placed, placed, or with an unknown outcome count against it. Purchases in other currencies are refused, and every purchase still needs your approval of the exact items and total."
          }
        }
      }
    },
    "The name can be at most 120 characters long.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يتجاوز طول الاسم 120 حرفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name darf höchstens 120 Zeichen lang sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name can be at most 120 characters long."
          }
        }
      }
    },
    "The number they see": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرقم الذي يظهر للطرف الآخر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angezeigte Nummer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number they see"
          }
        }
      }
    },
    "The offers are in different currencies. JARVIS doesn't convert them, because it has no exchange rate it can verify.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العروض بعملات مختلفة. لا يحوّلها JARVIS لأنه لا يملك سعر صرف يمكنه التحقق منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angebote sind in verschiedenen Währungen. JARVIS rechnet sie nicht um, weil es keinen Wechselkurs hat, den es überprüfen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offers are in different currencies. JARVIS doesn't convert them, because it has no exchange rate it can verify."
          }
        }
      }
    },
    "The order was interrupted while it was being placed. Check with the shop before ordering again; it counts against your monthly purchase limit until it's resolved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الطلب أثناء تقديمه. تحقق من المتجر قبل الطلب مجددًا؛ ويُحتسب ضمن حدك الشهري للمشتريات إلى أن يُحسم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bestellung wurde beim Aufgeben unterbrochen. Prüf das beim Shop, bevor du noch einmal bestellst; bis es geklärt ist, zählt sie zu deinem monatlichen Kauflimit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The order was interrupted while it was being placed. Check with the shop before ordering again; it counts against your monthly purchase limit until it's resolved."
          }
        }
      }
    },
    "The other person": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطرف الآخر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die andere Person"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person"
          }
        }
      }
    },
    "The other person (as recognised)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطرف الآخر (كما تم التعرّف عليه)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die andere Person (wie erkannt)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person (as recognised)"
          }
        }
      }
    },
    "The other person agreed to the recording": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق الطرف الآخر على التسجيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die andere Person hat der Aufzeichnung zugestimmt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person agreed to the recording"
          }
        }
      }
    },
    "The other person declined the recording": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الطرف الآخر التسجيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die andere Person hat die Aufzeichnung abgelehnt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person declined the recording"
          }
        }
      }
    },
    "The other person's words are what the phone provider recognised. JARVIS treats them as information, never as instructions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات الطرف الآخر هي ما تعرّف عليه مزوّد الاتصالات. يتعامل JARVIS معها كمعلومات، لا كتعليمات أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Worte der anderen Person sind das, was der Telefonanbieter erkannt hat. JARVIS behandelt sie als Information, nie als Anweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person's words are what the phone provider recognised. JARVIS treats them as information, never as instructions."
          }
        }
      }
    },
    "The page looks different than expected, so JARVIS stopped rather than guess.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو الصفحة مختلفة عمّا هو متوقع، لذا توقف JARVIS بدلًا من التخمين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite sieht anders aus als erwartet, daher hat JARVIS abgebrochen statt zu raten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page looks different than expected, so JARVIS stopped rather than guess."
          }
        }
      }
    },
    "The person asked not to be called again. Remove the number only if that was a misunderstanding — JARVIS can then call it again when you ask and approve.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب صاحب الرقم عدم الاتصال به مجددًا. لا تُزِل الرقم إلا إذا كان ذلك سوء فهم — يمكن لـJARVIS حينها الاتصال به مجددًا عندما تطلب ذلك وتوافق عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person hat gebeten, nicht mehr angerufen zu werden. Entferne die Nummer nur, wenn das ein Missverständnis war – JARVIS kann sie dann wieder anrufen, wenn du es anforderst und freigibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The person asked not to be called again. Remove the number only if that was a misunderstanding — JARVIS can then call it again when you ask and approve."
          }
        }
      }
    },
    "The phone provider didn't confirm whether the call was placed. Before calling again, JARVIS asks the provider and adopts that call if it exists, so the same call is never placed twice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكّد مزوّد الاتصالات ما إذا كانت المكالمة قد أُجريت. قبل الاتصال مجددًا، يسأل JARVIS المزوّد ويعتمد تلك المكالمة إن وُجدت، فلا تُجرى المكالمة نفسها مرتين أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Telefonanbieter hat nicht bestätigt, ob der Anruf aufgebaut wurde. Vor einem neuen Anruf fragt JARVIS beim Anbieter nach und übernimmt diesen Anruf, falls es ihn gibt – derselbe Anruf wird nie zweimal getätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone provider didn't confirm whether the call was placed. Before calling again, JARVIS asks the provider and adopts that call if it exists, so the same call is never placed twice."
          }
        }
      }
    },
    "The phone provider didn't confirm whether this call was placed. Before any new call, JARVIS asks the provider, so it is never placed twice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكّد مزوّد الاتصالات ما إذا كانت هذه المكالمة قد أُجريت. قبل أي مكالمة جديدة، يسأل JARVIS المزوّد، فلا تُجرى مرتين أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Telefonanbieter hat nicht bestätigt, ob dieser Anruf aufgebaut wurde. Vor jedem neuen Anruf fragt JARVIS beim Anbieter nach, damit er nie zweimal getätigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone provider didn't confirm whether this call was placed. Before any new call, JARVIS asks the provider, so it is never placed twice."
          }
        }
      }
    },
    "The price changed before the order was placed, so nothing was ordered.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر السعر قبل تقديم الطلب، لذا لم يُطلب شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Preis hat sich vor dem Aufgeben der Bestellung geändert, daher wurde nichts bestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price changed before the order was placed, so nothing was ordered."
          }
