    "Add facts and preferences you want JARVIS to keep in mind.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف حقائق وتفضيلات تريد أن يتذكرها JARVIS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Fakten und Vorlieben hinzu, die JARVIS sich merken soll."
