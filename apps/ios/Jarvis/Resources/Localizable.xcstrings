    "error.reason.POLICY_DENIED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظرت سياسة الأمان خطوة «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherheitsrichtlinie hat „%@“ blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The safety policy blocked “%@”."
          }
