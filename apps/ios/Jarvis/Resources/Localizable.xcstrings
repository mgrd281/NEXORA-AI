    "error.reason.PURCHASES_DISABLED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشتريات معطّلة. حدّد حدًا شهريًا للمشتريات في الإعدادات للسماح بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe sind ausgeschaltet. Leg in den Einstellungen ein monatliches Kauflimit fest, um sie zu erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases are turned off. Set a monthly purchase limit in Settings to allow them."
          }
        }
      }
    },
    "error.reason.PURCHASE_CURRENCY": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السعر بعملة %@، لكن حد مشترياتك بالدولار الأمريكي، لذا لن يشتريه JARVIS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
