    "It uses web content that looked like it was trying to instruct JARVIS.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم محتوى ويب بدا وكأنه يحاول توجيه تعليمات إلى JARVIS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie nutzt Webinhalte, die so aussahen, als wollten sie JARVIS Anweisungen geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It uses web content that looked like it was trying to instruct JARVIS."
          }
        }
      }
    },
    "It's safe to retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة المحاولة آمنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein erneuter Versuch ist unbedenklich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's safe to retry."
          }
        }
      }
    },
    "JARVIS can't confirm whether the last action took effect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS تأكيد ما إذا كان الإجراء الأخير قد نُفّذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann nicht bestätigen, ob die letzte Aktion ausgeführt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't confirm whether the last action took effect."
          }
        }
      }
    },
    "JARVIS can't do this kind of request yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS تنفيذ هذا النوع من الطلبات بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann diese Art von Anfrage noch nicht ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't do this kind of request yet."
          }
        }
      }
    },
    "JARVIS can't tell whether this action took effect. Check before retrying, so it isn't done twice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS معرفة ما إذا كان هذا الإجراء قد نُفّذ. تحقّق قبل إعادة المحاولة حتى لا يتكرّر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann nicht feststellen, ob diese Aktion ausgeführt wurde. Prüfe das vor einem erneuten Versuch, damit sie nicht doppelt passiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't tell whether this action took effect. Check before retrying, so it isn't done twice."
          }
        }
      }
    },
    "JARVIS couldn't confirm whether the last action took effect. For example, an email may already have been sent. Retrying could do it a second time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكّن JARVIS من تأكيد ما إذا كان الإجراء الأخير قد نُفّذ. فعلى سبيل المثال، ربما أُرسلت رسالة بريد إلكتروني بالفعل. قد تؤدي إعادة المحاولة إلى تنفيذه مرة ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS konnte nicht bestätigen, ob die letzte Aktion ausgeführt wurde. Zum Beispiel wurde eine E-Mail vielleicht schon gesendet. Ein erneuter Versuch könnte sie ein zweites Mal ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS couldn't confirm whether the last action took effect. For example, an email may already have been sent. Retrying could do it a second time."
          }
        }
      }
    },
    "JARVIS couldn't create the task: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على JARVIS إنشاء المهمة: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
