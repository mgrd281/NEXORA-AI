    },
    "error.reason.CAPTCHA_DETECTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب %@ إثبات أنك إنسان. لا يحل JARVIS هذه الاختبارات أبدًا: تابع على الموقع بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verlangt einen Nachweis, dass du ein Mensch bist. JARVIS löst so etwas nie: Mach selbst auf der Website weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks to prove you're human. JARVIS never solves these: continue on the site yourself."
          }
        }
      }
    },
    "error.reason.CHECKOUT_UNSUPPORTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS الطلب على %@. سلتك جاهزة هناك: أكمل الشراء بنفسك."
          }
        },
        "de": {
          "stringUnit": {
