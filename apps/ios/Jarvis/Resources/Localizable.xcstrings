    },
    "Some of the details aren't valid. Check them and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض التفاصيل غير صالحة. راجعها وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Angaben sind ungültig. Prüfe sie und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
