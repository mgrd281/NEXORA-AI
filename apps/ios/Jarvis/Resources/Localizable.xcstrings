    "Reads public web pages you link to, and supported sites in an isolated browser, and summarizes them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ صفحات الويب العامة التي ترسل روابطها، والمواقع المدعومة في متصفح معزول، ويلخصها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest öffentliche Webseiten, die du verlinkst, und unterstützte Websites in einem isolierten Browser und fasst sie zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads public web pages you link to, and supported sites in an isolated browser, and summarizes them."
          }
        }
      }
    },
    "Reads your calendar, finds free times, and adds or changes events after you approve them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ تقويمك ويجد الأوقات المتاحة، ويضيف المواعيد أو يغيّرها بعد موافقتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest deinen Kalender, findet freie Zeiten und trägt Termine ein oder ändert sie, nachdem du sie freigegeben hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your calendar, finds free times, and adds or changes events after you approve them."
          }
        }
      }
    },
    "Reads, summarizes and drafts replies to your mail, and sends emails from your connected account, each one after you approve it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ بريدك ويلخصه ويصوغ مسودات الردود، ويرسل الرسائل من حسابك المتصل، كلًّا منها بعد موافقتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest deine E-Mails, fasst sie zusammen, entwirft Antworten und sendet E-Mails über dein verbundenes Konto – jede erst nach deiner Freigabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads, summarizes and drafts replies to your mail, and sends emails from your connected account, each one after you approve it."
          }
        }
      }
    },
