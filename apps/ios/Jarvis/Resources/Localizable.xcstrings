    },
    "This schedule would never run.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُنفَّذ هذا الجدول أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zeitplan würde nie ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
