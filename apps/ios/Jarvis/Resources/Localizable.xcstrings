          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein persönlicher Agent. Er fragt, bevor er handelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal agent. It asks before it acts."
          }
