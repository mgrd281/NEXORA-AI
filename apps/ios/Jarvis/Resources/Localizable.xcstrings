          "stringUnit": {
            "state": "translated",
            "value": "This task can't do that in its current state. Refresh to see where it is."
          }
        }
      }
    },
    "This version of the app can't show this kind of action, so it can't be approved here. Update the app or review it on the web.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الإصدار من التطبيق عرض هذا النوع من الإجراءات، لذا لا يمكن الموافقة عليه هنا. حدّث التطبيق أو راجعه على الويب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App-Version kann diese Art von Aktion nicht anzeigen, daher kann sie hier nicht freigegeben werden. Aktualisiere die App oder prüfe sie im Web."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of the app can't show this kind of action, so it can't be approved here. Update the app or review it on the web."
          }
        }
      }
    },
