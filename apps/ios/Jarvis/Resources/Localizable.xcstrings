    "Memories that haven't changed for %@ are deleted automatically, once a day. Change this in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف تلقائيًا، مرة يوميًا، الذكريات التي لم تتغير منذ %@. يمكنك تغيير ذلك في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen, die %@ lang nicht geändert wurden, werden einmal täglich automatisch gelöscht. Das lässt sich in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memories that haven't changed for %@ are deleted automatically, once a day. Change this in Settings."
          }
        }
