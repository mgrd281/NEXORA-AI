    },
    "Your phone number is verified.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تأكيد رقم هاتفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Telefonnummer ist bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone number is verified."
          }
        }
      }
    },
    "Your request": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anfrage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your request"
          }
        }
      }
    },
    "Your request goes out as soon as JARVIS is reachable — and only once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُرسَل طلبك فور توفر الاتصال بـJARVIS — ومرة واحدة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anfrage geht raus, sobald JARVIS erreichbar ist – und nur einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your request goes out as soon as JARVIS is reachable — and only once."
          }
        }
      }
    },
    "Your requests and JARVIS's answers are in the conversation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلباتك وإجابات JARVIS موجودة في المحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anfragen und die Antworten von JARVIS stehen im Gespräch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your requests and JARVIS's answers are in the conversation."
          }
        }
      }
    },
    "Your session has ended. Sign in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلستك. سجّل الدخول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist beendet. Melde dich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has ended. Sign in again."
          }
        }
      }
    },
    "Your session on this iPhone ends and its token is removed from the Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي جلستك على هذا الـ iPhone ويُحذف رمزها من سلسلة المفاتيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung auf diesem iPhone endet und ihr Token wird aus dem Schlüsselbund entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session on this iPhone ends and its token is removed from the Keychain."
          }
        }
      }
    },
    "Your settings don't allow this action.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداداتك لا تسمح بهذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einstellungen erlauben diese Aktion nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings don't allow this action."
          }
        }
      }
    },
    "Your time zone is used for dates and times, for new schedules, and for when your monthly budget resets. The list shows the zones the server accepts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم منطقتك الزمنية للتواريخ والأوقات وللجداول الجديدة ولموعد إعادة تعيين ميزانيتك الشهرية. تعرض القائمة المناطق التي يقبلها الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitzone gilt für Datums- und Zeitangaben, für neue Zeitpläne und dafür, wann dein Monatsbudget zurückgesetzt wird. Die Liste zeigt die Zeitzonen, die der Server akzeptiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your time zone is used for dates and times, for new schedules, and for when your monthly budget resets. The list shows the zones the server accepts."
          }
        }
      }
    },
    "Your turn on the site": {
