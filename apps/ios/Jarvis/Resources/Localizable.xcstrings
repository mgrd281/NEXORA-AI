        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They asked to speak to a person."
          }
        }
      }
    },
    "They declined the recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الطرف الآخر التسجيل."
