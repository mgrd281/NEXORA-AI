    "The text comes from content that tried to instruct JARVIS, so it can't be saved to memory.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص مأخوذ من محتوى حاول توجيه تعليمات إلى JARVIS، لذا لا يمكن حفظه في الذاكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text stammt aus Inhalten, die JARVIS Anweisungen geben wollten, daher kann er nicht im Gedächtnis gespeichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text comes from content that tried to instruct JARVIS, so it can't be saved to memory."
          }
        }
      }
    },
    "The text to remember comes from an earlier result, so you decide exactly what is kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص المراد تذكّره مأخوذ من نتيجة سابقة، لذا تقرر أنت بالضبط ما يُحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der zu merkende Text stammt aus einem früheren Ergebnis, daher entscheidest du genau, was behalten wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text to remember comes from an earlier result, so you decide exactly what is kept."
          }
        }
