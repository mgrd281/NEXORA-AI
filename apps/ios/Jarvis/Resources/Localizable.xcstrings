    },
    "error.reason.CONNECTION_EXPIRED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية اتصالك بـ %@. أعد الاتصال ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Verbindung zu %@ ist abgelaufen. Verbinde sie neu und versuche es dann noch einmal."
