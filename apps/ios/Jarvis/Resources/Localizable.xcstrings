    "Plans each request, answers questions, asks when something is missing and reuses earlier results in a conversation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطّط لكل طلب، وتجيب عن الأسئلة، وتسأل عندما ينقص شيء، وتعيد استخدام النتائج السابقة في المحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant jede Anfrage, beantwortet Fragen, fragt nach, wenn etwas fehlt, und nutzt frühere Ergebnisse eines Gesprächs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans each request, answers questions, asks when something is missing and reuses earlier results in a conversation."
          }
        }
      }
    },
