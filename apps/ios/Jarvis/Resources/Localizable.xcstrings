    "Nothing is approved in advance: every run is planned and checked on its own, and anything that needs your approval will ask you then.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُوافَق على أي شيء مسبقًا: يُخطَّط لكل تنفيذ ويُفحص على حدة، وكل ما يحتاج إلى موافقتك سيسألك حينها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird im Voraus freigegeben: Jede Ausführung wird einzeln geplant und geprüft, und was eine Freigabe braucht, fragt dich dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is approved in advance: every run is planned and checked on its own, and anything that needs your approval will ask you then."
          }
        }
      }
    },
