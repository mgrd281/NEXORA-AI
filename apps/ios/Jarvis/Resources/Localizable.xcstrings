    },
    "This is saved even if the time overlaps another event in your calendar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ هذا حتى لو تداخل الوقت مع موعد آخر في تقويمك."
          }
