    "This saves a draft in your mailbox. Nothing is sent; you can review and send it yourself later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ هذا مسودة في صندوق بريدك. لا يُرسل شيء؛ ويمكنك مراجعتها وإرسالها بنفسك لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird ein Entwurf in deinem Postfach gespeichert. Es wird nichts gesendet; du kannst ihn später selbst prüfen und senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saves a draft in your mailbox. Nothing is sent; you can review and send it yourself later."
          }
        }
      }
    },
    "This schedule repeats in a way this app can't edit. You can change its name and request here, and its timing in JARVIS on the web.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتكرر هذا الجدول بطريقة لا يستطيع هذا التطبيق تعديلها. يمكنك تغيير اسمه وطلبه هنا، ومواعيده من JARVIS على الويب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zeitplan wiederholt sich auf eine Weise, die diese App nicht bearbeiten kann. Name und Anfrage änderst du hier, die Zeiten in JARVIS im Web."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This schedule repeats in a way this app can't edit. You can change its name and request here, and its timing in JARVIS on the web."
          }
        }
      }
    },
