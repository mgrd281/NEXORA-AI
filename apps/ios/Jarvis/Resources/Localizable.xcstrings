    },
    "error.reason.CONNECTION_SCOPE_MISSING": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يمنح %@ JARVIS هذا الإذن: %@. أعد الاتصال واسمح به ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat JARVIS diese Berechtigung nicht erteilt: %@. Verbinde neu, erlaube sie und versuche es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't given JARVIS this permission: %@. Reconnect and allow it, then retry."
          }
        }
      }
    },
    "error.reason.CONNECT_FAILED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على JARVIS الاتصال بـ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS konnte keine Verbindung zu %@ herstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS couldn't connect to %@."
