    "Saved to your account, so the web app uses it too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ في حسابك، لذا يستخدمه تطبيق الويب أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird in deinem Konto gespeichert und gilt daher auch für die Web-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to your account, so the web app uses it too."
          }
        }
      }
    },
    "Saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved."
          }
        }
      }
    },
    "Saved. JARVIS may spend up to %@ a month, each purchase after you approve it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. يمكن لـ JARVIS إنفاق ما يصل إلى %@ شهريًا، وكل عملية شراء بعد موافقتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. JARVIS darf bis zu %@ im Monat ausgeben, jeden Kauf erst nach deiner Freigabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. JARVIS may spend up to %@ a month, each purchase after you approve it."
          }
        }
      }
    },
    "Saved. Purchases are off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. المشتريات معطّلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Käufe sind aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Purchases are off."
          }
        }
      }
    },
    "Saved. Verify it so JARVIS can put callers through to you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. أكّد الرقم ليتمكن JARVIS من تحويل المتصلين إليك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Bestätige sie, damit JARVIS Gesprächspartner zu dir durchstellen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Verify it so JARVIS can put callers through to you."
          }
        }
      }
    },
    "Say something, or type below. Everything that is said appears here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل شيئًا أو اكتب في الأسفل. يظهر هنا كل ما يُقال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag etwas oder schreib unten. Alles, was gesagt wird, erscheint hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say something, or type below. Everything that is said appears here."
          }
        }
      }
    },
