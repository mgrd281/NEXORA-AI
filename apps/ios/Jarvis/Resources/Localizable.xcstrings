    "error.api.ATTACHMENT_EXPIRED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية أحد الملفات قبل إرساله. أرفقه من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine der Dateien ist abgelaufen, bevor sie gesendet wurde. Hänge sie erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the files expired before it was sent. Attach it again."
          }
        }
      }
    },
    "error.api.ATTACHMENT_IN_OTHER_CONVERSATION": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحد الملفات ينتمي إلى محادثة أخرى. أرفقه هنا من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine der Dateien gehört zu einem anderen Gespräch. Hänge sie hier erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the files belongs to another conversation. Attach it again here."
          }
        }
      }
    },
    "error.api.ATTACHMENT_NOT_FOUND": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحد الملفات لم يعد موجودًا. أزِله ثم أرفقه من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine der Dateien existiert nicht mehr. Entferne sie und hänge sie erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the files no longer exists. Remove it and attach it again."
          }
        }
      }
    },
    "error.api.CALENDAR_NOT_CONNECTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تقويم متصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Kalender verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendar is connected."
          }
        }
      }
    },
    "error.api.CALENDAR_UNAVAILABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُجب %@ في الوقت المناسب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht rechtzeitig geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't answer in time."
          }
        }
      }
    },
    "error.api.CALL_DESTINATION_BLOCKED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتصل JARVIS بأرقام كهذا الرقم: الأرقام ذات التعرفة المرتفعة والبلدان التي لا يتصل بها هذا الخادم محظورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ruft solche Nummern nicht an: Mehrwertnummern und Länder, die dieser Server nicht anruft, sind gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS doesn't call numbers like this one: premium-rate numbers and countries this server doesn't call are blocked."
          }
        }
      }
    },
    "error.api.CONNECTION_NOT_OAUTH": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إعادة ربط هذا الاتصال بهذه الطريقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung lässt sich so nicht neu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection can't be reconnected this way."
          }
        }
      }
    },
    "error.api.CONVERSATION_ACTIVE_TASK": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت إحدى مهام هذه المحادثة قيد التنفيذ. انتظر حتى تنتهي أو ألغِها، ثم احذف المحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe in diesem Gespräch läuft noch. Warte, bis sie fertig ist, oder brich sie ab, und lösche dann das Gespräch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task in this conversation is still running. Wait until it finishes or cancel it, then delete the conversation."
          }
        }
      }
    },
    "error.api.CONVERSATION_BUSY": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال JARVIS يعمل على هذه المحادثة. انتظر حتى ينتهي أو ألغِ المهمة، ثم أرسل متابعتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS arbeitet noch an diesem Gespräch. Warte, bis es fertig ist, oder brich es ab, und sende dann deine Nachfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is still working on this conversation. Wait until it finishes or cancel it, then send your follow-up."
          }
        }
      }
    },
    "error.api.EVIDENCE_NOT_AVAILABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة ملف الإثبات هذا على هذا الخادم حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nachweisdatei kann auf diesem Server gerade nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This evidence file can't be read on this server right now."
          }
        }
      }
    },
    "error.api.FILE_CONTENT_MISMATCH": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محتوى الملف لا يطابق نوعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt der Datei passt nicht zu ihrem Dateityp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file's content doesn't match its file type."
          }
        }
      }
    },
    "error.api.FILE_EMPTY": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف فارغ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is empty."
          }
        }
      }
    },
    "error.api.FILE_TOO_LARGE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى لحجم الملف %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien dürfen höchstens %@ groß sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files can be at most %@."
          }
        }
      }
    },
    "error.api.INVALID_RECURRENCE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة التكرار هذه غير صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wiederholungsregel ist ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repeat rule isn't valid."
          }
        }
      }
    },
    "error.api.OAUTH_ACCOUNT_MISMATCH": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّلت الدخول بحساب %@ مختلف. افصل الحساب القديم أولًا للتبديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dich mit einem anderen %@-Konto angemeldet. Trenne zuerst das alte, um zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You signed in to a different %@ account. Disconnect the old one first to switch."
          }
        }
      }
    },
    "error.api.OAUTH_DENIED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تسمح بالوصول لدى %@، لذا لم يُربط أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Zugriff bei %@ nicht erlaubt, daher wurde nichts verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You didn't allow access at %@, so nothing was connected."
          }
        }
      }
    },
    "error.api.OAUTH_EXCHANGE_FAILED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُكمل %@ تسجيل الدخول. حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Anmeldung nicht abgeschlossen. Versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't complete the sign-in. Try again."
          }
        }
      }
    },
    "error.api.OAUTH_PENDING_LIMIT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عمليات تسجيل دخول كثيرة ما زالت مفتوحة. أكملها أو انتظر بضع دقائق ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldungen sind noch offen. Schließ sie ab oder warte ein paar Minuten, dann versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-ins are still open. Finish them or wait a few minutes, then try again."
          }
        }
      }
    },
    "error.api.OAUTH_SCOPE_NOT_GRANTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسمح بأي من الأذونات التي طلبها JARVIS، لذا لم يُربط أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine der angefragten Berechtigungen wurde erlaubt, daher wurde nichts verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the permissions JARVIS asked for were allowed, so nothing was connected."
          }
        }
      }
    },
    "error.api.OAUTH_STATE_EXPIRED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق تسجيل الدخول وقتًا طويلًا. ابدأ الاتصال من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hat zu lange gedauert. Starte die Verbindung noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in took too long. Start connecting again."
          }
        }
      }
    },
    "error.api.OAUTH_STATE_INVALID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط تسجيل الدخول هذا لم يعد صالحًا. ابدأ الاتصال من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anmeldelink ist nicht mehr gültig. Starte die Verbindung noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sign-in link isn't valid any more. Start connecting again."
          }
        }
      }
    },
    "error.api.PHONE_ALREADY_VERIFIED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرقم مؤكَّد بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nummer ist bereits bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This number is already verified."
          }
        }
      }
    },
    "error.api.PHONE_NUMBER_INVALID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس رقم هاتف صالحًا. اكتبه مع رمز الدولة، على سبيل المثال +49 30 1234567."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige Telefonnummer. Schreib sie mit Ländervorwahl, zum Beispiel +49 30 1234567."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn't a valid phone number. Write it with its country code, for example +49 30 1234567."
          }
        }
      }
    },
    "error.api.PHONE_NUMBER_REQUIRED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف رقم هاتفك أولًا."
