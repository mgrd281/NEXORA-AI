    "error.api.FILE_TOO_LARGE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى لحجم الملف %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien dürfen höchstens %@ groß sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files can be at most %@."
          }
        }
      }
    },
    "error.api.INVALID_RECURRENCE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة التكرار هذه غير صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wiederholungsregel ist ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repeat rule isn't valid."
          }
        }
      }
    },
    "error.api.RECURRENCE_HAS_NO_OCCURRENCES": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُنفَّذ هذا الجدول أبدًا. راجع الأيام التي اخترتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zeitplan würde nie ausgeführt. Prüfe die gewählten Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This schedule would never run. Check the days you chose."
          }
        }
      }
    },
    "error.api.SCHEDULE_COMPLETED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتبقَّ لهذا الجدول أي تنفيذ، لذا لا يمكن استئنافه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Zeitplan sind keine Ausführungen mehr übrig, daher lässt er sich nicht fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This schedule has no runs left, so it can't be resumed."
          }
        }
      }
    },
    "error.api.SCHEDULE_LIMIT_REACHED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى %@ جداول. احذف جدولًا لإضافة جدول جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind höchstens %@ Zeitpläne möglich. Lösche einen, um einen neuen anzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can have up to %@ schedules. Delete one to add another."
          }
        }
      }
    },
    "error.api.SKILL_NOT_TOGGLEABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهارة جزء من طريقة عمل JARVIS ولا يمكن إيقافها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fähigkeit gehört zur Grundfunktion von JARVIS und lässt sich nicht ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This skill is part of how JARVIS works and can't be turned off."
          }
        }
      }
    },
    "error.api.SKILL_PLANNED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهارة غير متاحة بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fähigkeit ist noch nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This skill isn't available yet."
          }
        }
      }
    },
    "error.api.STORAGE_NOT_CONFIGURED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفع الملفات غير مُعَدّ على هذا الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei-Uploads sind auf diesem Server nicht eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File uploads aren't set up on this server."
          }
        }
      }
    },
    "error.api.STORAGE_UNAVAILABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخزين الملفات غير متاح حاليًا. حاول مرة أخرى بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
