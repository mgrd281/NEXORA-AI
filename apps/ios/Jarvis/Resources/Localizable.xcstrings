          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is password-protected, so JARVIS can't read it."
          }
        }
      }
    },
    "error.reason.ATTACHMENT_NOT_FOUND": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف المرفق لم يعد موجودًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angehängte Datei existiert nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attached file no longer exists."
          }
        }
      }
    },
    "error.reason.ATTACHMENT_UNREADABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على JARVIS قراءة الملف المرفق، وقد يكون تالفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS konnte die angehängte Datei nicht lesen. Möglicherweise ist sie beschädigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS couldn't read the attached file. It may be damaged."
          }
        }
      }
    },
    "error.reason.BUDGET_EXHAUSTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت ميزانية الذكاء الاصطناعي لهذا الشهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das KI-Budget für diesen Monat ist aufgebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's AI budget is used up."
          }
        }
      }
    },
    "error.reason.BUDGET_ZERO": {
      "localizations": {
        "ar": {
          "stringUnit": {
