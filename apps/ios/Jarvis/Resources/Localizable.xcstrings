    "Reads files you attach (PDF, Word, text, CSV) and summarizes them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقرأ الملفات التي ترفقها (PDF وWord والنصوص وCSV) وتلخّصها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
