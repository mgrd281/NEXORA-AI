      }
    },
    "error.reason.BROWSER_BUDGET_EXCEEDED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتاج الموقع إلى خطوات أكثر مما يسمح به JARVIS (%@)، لذا توقف."
