        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page is larger than %@ MB."
          }
        }
      }
    },
    "error.reason.PHONE_NUMBER_INVALID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
