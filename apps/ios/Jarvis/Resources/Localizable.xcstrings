          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App-Version kann diese Art von Aktion nicht anzeigen, daher kann sie hier nicht freigegeben werden. Aktualisiere die App oder prüfe sie im Web."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
