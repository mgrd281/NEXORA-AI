    "error.reason.SKILL_DISABLED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب هذا مهارة «%@»، وهي متوقفة في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
