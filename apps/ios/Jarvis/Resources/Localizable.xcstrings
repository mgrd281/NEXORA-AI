    "This spends your money. JARVIS always asks, and shows the exact total.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ينفق من مالك. يسأل JARVIS دائمًا ويعرض المبلغ الإجمالي الدقيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kostet dich Geld. JARVIS fragt immer und zeigt den genauen Gesamtbetrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This spends your money. JARVIS always asks, and shows the exact total."
          }
        }
      }
    },
    "This task can't do that in its current state. Refresh to see where it is.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تنفيذ ذلك في الحالة الحالية لهذه المهمة. حدّث لمعرفة وضعها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geht im aktuellen Zustand dieser Aufgabe nicht. Aktualisiere, um den Stand zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task can't do that in its current state. Refresh to see where it is."
          }
        }
      }
    },
    "This version of the app can't show this kind of action, so it can't be approved here. Update the app or review it on the web.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الإصدار من التطبيق عرض هذا النوع من الإجراءات، لذا لا يمكن الموافقة عليه هنا. حدّث التطبيق أو راجعه على الويب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App-Version kann diese Art von Aktion nicht anzeigen, daher kann sie hier nicht freigegeben werden. Aktualisiere die App oder prüfe sie im Web."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of the app can't show this kind of action, so it can't be approved here. Update the app or review it on the web."
          }
        }
      }
    },
    "Threads JARVIS watches for replies in this account are no longer watched.": {
      "localizations": {
        "ar": {
