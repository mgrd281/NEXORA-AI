{
  "sourceLanguage": "en",
  "strings": {
    "%@ didn't answer in time. These events may be missing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُجب %@ في الوقت المناسب. قد تكون هذه المواعيد ناقصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht rechtzeitig geantwortet. Diese Termine fehlen möglicherweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't answer in time. These events may be missing."
          }
        }
      }
    },
    "%@ disconnected. Its tokens were erased.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُطع الاتصال بـ %@. ومُحيت رموزه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ getrennt. Die Tokens wurden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disconnected. Its tokens were erased."
          }
        }
      }
    },
    "%@ each": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ للقطعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "je %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each"
          }
        }
      }
    },
    "%@ emails each guest an invitation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل %@ دعوة بالبريد الإلكتروني إلى كل ضيف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schickt jedem Gast eine Einladung per E-Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ emails each guest an invitation."
          }
        }
      }
    },
    "%@ emails each guest that the event is cancelled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبلغ %@ كل ضيف بالبريد الإلكتروني بإلغاء الموعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ teilt jedem Gast per E-Mail mit, dass der Termin abgesagt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ emails each guest that the event is cancelled."
          }
        }
      }
    },
    "%@ emails each guest the change.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبلغ %@ كل ضيف بالتغيير بالبريد الإلكتروني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ teilt jedem Gast die Änderung per E-Mail mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ emails each guest the change."
          }
        }
      }
    },
    "%@ is connected": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم ربط %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist verbunden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is connected"
          }
        }
      }
    },
    "%@ isn't responding reliably. JARVIS tries again with the next request; reconnecting can help if it keeps happening.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستجيب %@ بشكل موثوق. يحاول JARVIS مجددًا مع الطلب التالي؛ وقد تساعد إعادة الربط إذا تكرر ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antwortet nicht zuverlässig. JARVIS versucht es mit der nächsten Anfrage erneut; wenn das öfter passiert, kann neu Verbinden helfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't responding reliably. JARVIS tries again with the next request; reconnecting can help if it keeps happening."
          }
        }
      }
    },
    "%@ no longer accepts JARVIS's access: it was revoked or ran out. Until you reconnect, JARVIS can't read or change anything there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد %@ يقبل وصول JARVIS: فقد أُلغي أو انتهت صلاحيته. إلى أن تعيد الربط، لا يستطيع JARVIS قراءة أي شيء هناك أو تغييره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akzeptiert den Zugriff von JARVIS nicht mehr: Er wurde widerrufen oder ist abgelaufen. Bis du neu verbindest, kann JARVIS dort nichts lesen oder ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no longer accepts JARVIS's access: it was revoked or ran out. Until you reconnect, JARVIS can't read or change anything there."
          }
        }
      }
    },
    "%@ rejected JARVIS's access. Until you reconnect, JARVIS can't read or change anything there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض %@ وصول JARVIS. إلى أن تعيد الربط، لا يستطيع JARVIS قراءة أي شيء هناك أو تغييره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Zugriff von JARVIS abgelehnt. Bis du neu verbindest, kann JARVIS dort nichts lesen oder ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rejected JARVIS's access. Until you reconnect, JARVIS can't read or change anything there."
          }
        }
      }
    },
    "%@ replied %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ %1$@ %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat %2$@ geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ replied %@."
          }
        }
      }
    },
    "%@ will be signed out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تسجيل خروج %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird abgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be signed out."
          }
        }
      }
    },
    "%@ withdrew a permission. JARVIS keeps working with what is still allowed; allow the rest again if you need it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سحب %@ أحد الأذونات. يواصل JARVIS العمل بما لا يزال مسموحًا به؛ اسمح بالباقي مجددًا إذا احتجت إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat eine Berechtigung entzogen. JARVIS arbeitet mit dem weiter, was noch erlaubt ist; erlaube den Rest erneut, wenn du ihn brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ withdrew a permission. JARVIS keeps working with what is still allowed; allow the rest again if you need it."
          }
        }
      }
    },
    "%@ · all day": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · طوال اليوم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ganztägig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · all day"
          }
        }
      }
    },
    "%@: JARVIS isn't allowed to read this calendar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: لا يُسمح لـ JARVIS بقراءة هذا التقويم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: JARVIS darf diesen Kalender nicht lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: JARVIS isn't allowed to read this calendar."
          }
        }
      }
    },
    "%@: the connection has expired. Reconnect it to see these events.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: انتهت صلاحية الاتصال. أعد الربط لترى هذه المواعيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Die Verbindung ist abgelaufen. Verbinde sie neu, um diese Termine zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: the connection has expired. Reconnect it to see these events."
          }
        }
      }
    },
    "%@: these events may be missing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: قد تكون هذه المواعيد ناقصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Diese Termine fehlen möglicherweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: these events may be missing."
          }
        }
      }
    },
    "(no subject)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "(بلا موضوع)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(kein Betreff)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no subject)"
          }
        }
      }
    },
    "(no title)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "(بلا عنوان)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(ohne Titel)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no title)"
          }
        }
      }
    },
    "0 turns purchases off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيمة 0 تعطّل المشتريات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 schaltet Käufe aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 turns purchases off"
          }
        }
      }
    },
    "A connected service didn't respond. Check the connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب إحدى الخدمات المتصلة. تحقّق من الاتصال وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein verbundener Dienst hat nicht geantwortet. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connected service didn't respond. Check the connection and try again."
          }
        }
      }
    },
    "A memory needs between 1 and 1,000 characters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تحتوي الذكرى على 1 إلى 1000 حرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung braucht 1 bis 1.000 Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A memory needs between 1 and 1,000 characters."
          }
        }
      }
    },
    "A month without this day is skipped.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتخطّى الشهر الذي لا يحتوي على هذا اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monate ohne diesen Tag werden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A month without this day is skipped."
          }
        }
      }
    },
    "A permission this version of the app doesn't know yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن لا يعرفه هذا الإصدار من التطبيق بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Berechtigung, die diese App-Version noch nicht kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A permission this version of the app doesn't know yet."
          }
        }
      }
    },
    "A required service isn't connected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة مطلوبة غير متصلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein benötigter Dienst ist nicht verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A required service isn't connected."
          }
        }
      }
    },
    "A schedule runs again in the future, so JARVIS asks before creating it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنفَّذ الجدول لاحقًا من تلقاء نفسه، لذا يسألك JARVIS قبل إنشائه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zeitplan läuft später von selbst weiter, daher fragt JARVIS, bevor er angelegt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A schedule runs again in the future, so JARVIS asks before creating it."
          }
        }
      }
    },
    "A service this version of the app doesn't know yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة لا يعرفها هذا الإصدار من التطبيق بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Dienst, den diese App-Version noch nicht kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A service this version of the app doesn't know yet."
          }
        }
      }
    },
    "A skill this version of the app doesn't know yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهارة لا يعرفها هذا الإصدار من التطبيق بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Fähigkeit, die diese App-Version noch nicht kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A skill this version of the app doesn't know yet."
          }
        }
      }
    },
    "A source used for this tried to give instructions to AI assistants.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول نص في أحد المصادر المستخدمة إعطاء تعليمات لمساعدي الذكاء الاصطناعي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine verwendete Quelle hat versucht, KI-Assistenten Anweisungen zu geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A source used for this tried to give instructions to AI assistants."
          }
        }
      }
    },
    "A step didn't finish. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكتمل إحدى الخطوات. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schritt wurde nicht abgeschlossen. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A step didn't finish. Try again."
          }
        }
      }
    },
    "A way this version of the app doesn't know": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
