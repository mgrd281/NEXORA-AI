    "error.api.ATTACHMENT_EXPIRED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية أحد الملفات قبل إرساله. أرفقه من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine der Dateien ist abgelaufen, bevor sie gesendet wurde. Hänge sie erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the files expired before it was sent. Attach it again."
          }
        }
      }
    },
    "error.api.ATTACHMENT_IN_OTHER_CONVERSATION": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحد الملفات ينتمي إلى محادثة أخرى. أرفقه هنا من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine der Dateien gehört zu einem anderen Gespräch. Hänge sie hier erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the files belongs to another conversation. Attach it again here."
          }
        }
      }
    },
    "error.api.ATTACHMENT_NOT_FOUND": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحد الملفات لم يعد موجودًا. أزِله ثم أرفقه من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine der Dateien existiert nicht mehr. Entferne sie und hänge sie erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the files no longer exists. Remove it and attach it again."
          }
        }
      }
    },
    "error.api.CALENDAR_NOT_CONNECTED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تقويم متصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Kalender verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendar is connected."
          }
        }
      }
    },
    "error.api.CALENDAR_UNAVAILABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُجب %@ في الوقت المناسب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht rechtzeitig geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't answer in time."
          }
        }
      }
    },
    "error.api.CONNECTION_NOT_OAUTH": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إعادة ربط هذا الاتصال بهذه الطريقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung lässt sich so nicht neu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection can't be reconnected this way."
          }
        }
      }
    },
    "error.api.CONVERSATION_ACTIVE_TASK": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت إحدى مهام هذه المحادثة قيد التنفيذ. انتظر حتى تنتهي أو ألغِها، ثم احذف المحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe in diesem Gespräch läuft noch. Warte, bis sie fertig ist, oder brich sie ab, und lösche dann das Gespräch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task in this conversation is still running. Wait until it finishes or cancel it, then delete the conversation."
          }
        }
      }
    },
    "error.api.CONVERSATION_BUSY": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال JARVIS يعمل على هذه المحادثة. انتظر حتى ينتهي أو ألغِ المهمة، ثم أرسل متابعتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS arbeitet noch an diesem Gespräch. Warte, bis es fertig ist, oder brich es ab, und sende dann deine Nachfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is still working on this conversation. Wait until it finishes or cancel it, then send your follow-up."
          }
        }
      }
    },
    "error.api.EVIDENCE_NOT_AVAILABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة ملف الإثبات هذا على هذا الخادم حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nachweisdatei kann auf diesem Server gerade nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This evidence file can't be read on this server right now."
          }
        }
      }
    },
    "error.api.FILE_CONTENT_MISMATCH": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
