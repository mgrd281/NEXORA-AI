    "error.reason.BOOKING_UNCONFIRMED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسل الحجز، لكن الموقع لم يعرض تأكيدًا. تحقق من الموقع قبل المحاولة مجددًا."
