    "JARVIS is using its offline rules engine for simple, well-defined requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS محرّك القواعد دون اتصال للطلبات البسيطة والمحدّدة بوضوح."
          }
        },
        "de": {
