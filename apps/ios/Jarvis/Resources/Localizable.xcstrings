    "It didn't run.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنفَّذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nicht ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It didn't run."
          }
        }
      }
    },
    "It goes to more than three people.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذهب إلى أكثر من ثلاثة أشخاص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es geht an mehr als drei Personen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes to more than three people."
          }
        }
      }
    },
    "It goes to someone other than you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذهب إلى شخص غيرك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es geht an jemand anderen als dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes to someone other than you."
          }
        }
      }
    },
    "It runs again from the next scheduled time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستأنف التنفيذ من الموعد المجدول التالي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er läuft ab dem nächsten geplanten Zeitpunkt wieder"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It runs again from the next scheduled time"
          }
        }
      }
    },
    "It stopped for a reason this version of the app doesn't know.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف لسبب لا يعرفه هذا الإصدار من التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen aus einem Grund, den diese App-Version nicht kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stopped for a reason this version of the app doesn't know."
          }
        }
      }
    },
    "It uses web content that looked like it was trying to instruct JARVIS.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم محتوى ويب بدا وكأنه يحاول توجيه تعليمات إلى JARVIS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie nutzt Webinhalte, die so aussahen, als wollten sie JARVIS Anweisungen geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It uses web content that looked like it was trying to instruct JARVIS."
          }
        }
      }
    },
    "It won't run until you resume it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُنفَّذ حتى تستأنفه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er läuft erst wieder, wenn du ihn fortsetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It won't run until you resume it"
          }
        }
      }
    },
    "It would go over your monthly purchase limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتجاوز حدك الشهري للمشتريات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es würde dein monatliches Kauflimit überschreiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It would go over your monthly purchase limit."
          }
        }
      }
    },
    "It's safe to retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة المحاولة آمنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein erneuter Versuch ist unbedenklich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's safe to retry."
          }
        }
      }
    },
    "Items": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنتجات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items"
          }
        }
      }
    },
    "Its requests, results and attached files are deleted. This can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف طلباتها ونتائجها والملفات المرفقة بها. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Anfragen, Ergebnisse und angehängten Dateien werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its requests, results and attached files are deleted. This can't be undone."
          }
        }
      }
    },
    "Its requests, results and attached files are deleted. This can't be undone. The schedule that runs it stays; its next run starts a new conversation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف طلباتها ونتائجها والملفات المرفقة بها. لا يمكن التراجع عن ذلك. يبقى الجدول الذي ينفّذها، وسيبدأ تنفيذه التالي محادثة جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Anfragen, Ergebnisse und angehängten Dateien werden gelöscht. Das lässt sich nicht rückgängig machen. Der Zeitplan, der es ausführt, bleibt bestehen; seine nächste Ausführung beginnt ein neues Gespräch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its requests, results and attached files are deleted. This can't be undone. The schedule that runs it stays; its next run starts a new conversation."
          }
        }
      }
    },
    "JARVIS can now use %@ to:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ JARVIS الآن استخدام %@ من أجل:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann %@ jetzt nutzen, um:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can now use %@ to:"
          }
        }
      }
    },
    "JARVIS can't confirm whether the last action took effect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS تأكيد ما إذا كان الإجراء الأخير قد نُفّذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann nicht bestätigen, ob die letzte Aktion ausgeführt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't confirm whether the last action took effect."
          }
        }
      }
    },
    "JARVIS can't do this kind of request yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS تنفيذ هذا النوع من الطلبات بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann diese Art von Anfrage noch nicht ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't do this kind of request yet."
          }
        }
      }
    },
    "JARVIS can't order on this shop. Your cart is ready there: finish the purchase yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS الطلب من هذا المتجر. سلتك جاهزة هناك: أكمل الشراء بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann in diesem Shop nicht bestellen. Dein Warenkorb ist dort bereit: Schließ den Kauf selbst ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't order on this shop. Your cart is ready there: finish the purchase yourself."
          }
        }
      }
    },
    "JARVIS can't order on this site. Finish the purchase on the site yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS الطلب على هذا الموقع. أكمل الشراء على الموقع بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann auf dieser Website nicht bestellen. Schließ den Kauf selbst auf der Website ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't order on this site. Finish the purchase on the site yourself."
          }
        }
      }
    },
    "JARVIS can't tell whether this action took effect. Check before retrying, so it isn't done twice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS معرفة ما إذا كان هذا الإجراء قد نُفّذ. تحقّق قبل إعادة المحاولة حتى لا يتكرّر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS kann nicht feststellen, ob diese Aktion ausgeführt wurde. Prüfe das vor einem erneuten Versuch, damit sie nicht doppelt passiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't tell whether this action took effect. Check before retrying, so it isn't done twice."
          }
        }
      }
    },
    "JARVIS can't use this kind of file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع JARVIS استخدام هذا النوع من الملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser Art von Datei kann JARVIS nichts anfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS can't use this kind of file."
          }
        }
      }
    },
    "JARVIS checks each thread about every 10 minutes and tells you when a reply arrives. It only reads who replied and the subject.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق JARVIS من كل سلسلة رسائل كل 10 دقائق تقريبًا ويخبرك عند وصول رد. ولا يقرأ إلا اسم من ردّ والموضوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS prüft jede Unterhaltung etwa alle 10 Minuten und sagt dir Bescheid, wenn eine Antwort ankommt. Dabei liest es nur, wer geantwortet hat, und den Betreff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS checks each thread about every 10 minutes and tells you when a reply arrives. It only reads who replied and the subject."
          }
        }
      }
    },
    "JARVIS checks once a day. Memories that haven't changed for the chosen period are deleted, and so are finished tasks older than it, with their conversations, results, approvals and attached files. Deleted data can't be recovered. Files you attach but never send are deleted after 24 hours.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق JARVIS مرة يوميًا. تُحذف الذكريات التي لم تتغير خلال المدة المختارة، وكذلك المهام المنتهية الأقدم منها مع محادثاتها ونتائجها وموافقاتها والملفات المرفقة بها. لا يمكن استعادة البيانات المحذوفة. تُحذف الملفات التي ترفقها ولا ترسلها بعد 24 ساعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS prüft einmal täglich. Erinnerungen, die im gewählten Zeitraum nicht geändert wurden, werden gelöscht, ebenso abgeschlossene Aufgaben, die älter sind – mit ihren Gesprächen, Ergebnissen, Freigaben und angehängten Dateien. Gelöschte Daten lassen sich nicht wiederherstellen. Angehängte, aber nie gesendete Dateien werden nach 24 Stunden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS checks once a day. Memories that haven't changed for the chosen period are deleted, and so are finished tasks older than it, with their conversations, results, approvals and attached files. Deleted data can't be recovered. Files you attach but never send are deleted after 24 hours."
          }
        }
      }
    },
    "JARVIS checks the cart again right before ordering. If the price or the items changed, it stops and nothing is ordered. The order is placed only once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق JARVIS من السلة مجددًا قبل الطلب مباشرة. إذا تغيّر السعر أو المنتجات، يتوقف ولا يُطلب شيء. ويُقدَّم الطلب مرة واحدة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS prüft den Warenkorb direkt vor dem Bestellen noch einmal. Haben sich Preis oder Artikel geändert, bricht es ab und es wird nichts bestellt. Die Bestellung wird nur einmal aufgegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS checks the cart again right before ordering. If the price or the items changed, it stops and nothing is ordered. The order is placed only once."
          }
        }
      }
    },
    "JARVIS couldn't confirm whether the last action took effect. For example, an email may already have been sent. Retrying could do it a second time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكّن JARVIS من تأكيد ما إذا كان الإجراء الأخير قد نُفّذ. فعلى سبيل المثال، ربما أُرسلت رسالة بريد إلكتروني بالفعل. قد تؤدي إعادة المحاولة إلى تنفيذه مرة ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS konnte nicht bestätigen, ob die letzte Aktion ausgeführt wurde. Zum Beispiel wurde eine E-Mail vielleicht schon gesendet. Ein erneuter Versuch könnte sie ein zweites Mal ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS couldn't confirm whether the last action took effect. For example, an email may already have been sent. Retrying could do it a second time."
          }
        }
      }
    },
    "JARVIS couldn't create the task: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على JARVIS إنشاء المهمة: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS konnte die Aufgabe nicht erstellen: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS couldn't create the task: %@"
          }
        }
      }
    },
    "JARVIS couldn't verify the result.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على JARVIS التحقق من النتيجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS konnte das Ergebnis nicht überprüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS couldn't verify the result."
          }
        }
      }
    },
    "JARVIS created this from a request you approved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشأ JARVIS هذا الجدول من طلب وافقت عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat diesen Zeitplan aus einer Anfrage angelegt, die du freigegeben hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS created this from a request you approved."
          }
        }
      }
    },
    "JARVIS erases its tokens right away and asks the provider to revoke its access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمحو JARVIS رموزه فورًا ويطلب من المزوّد إلغاء وصوله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS löscht seine Tokens sofort und bittet den Anbieter, seinen Zugriff zu widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS erases its tokens right away and asks the provider to revoke its access."
          }
        }
      }
    },
    "JARVIS erases its tokens right away.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمحو JARVIS رموزه فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS löscht seine Tokens sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS erases its tokens right away."
          }
        }
      }
    },
    "JARVIS erases its tokens right away. Microsoft doesn't let apps revoke their own access, so also remove JARVIS from your account: account.live.com/consent/Manage for personal accounts, myapps.microsoft.com for work or school accounts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمحو JARVIS رموزه فورًا. لا تسمح Microsoft للتطبيقات بإلغاء وصولها بنفسها، لذا أزل JARVIS من حسابك أيضًا: account.live.com/consent/Manage للحسابات الشخصية، وmyapps.microsoft.com لحسابات العمل أو المدرسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS löscht seine Tokens sofort. Microsoft lässt Apps ihren eigenen Zugriff nicht widerrufen, entferne JARVIS daher auch in deinem Konto: account.live.com/consent/Manage für private Konten, myapps.microsoft.com für Geschäfts- oder Schulkonten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS erases its tokens right away. Microsoft doesn't let apps revoke their own access, so also remove JARVIS from your account: account.live.com/consent/Manage for personal accounts, myapps.microsoft.com for work or school accounts."
          }
        }
      }
    },
    "JARVIS has a question": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدى JARVIS سؤال"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat eine Rückfrage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS has a question"
          }
        }
      }
    },
    "JARVIS is listening": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS يستمع"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hört zu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is listening"
          }
        }
      }
    },
    "JARVIS is placing this order. It counts against your monthly purchase limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقدّم JARVIS هذا الطلب الآن. ويُحتسب ضمن حدك الشهري للمشتريات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS gibt diese Bestellung gerade auf. Sie zählt zu deinem monatlichen Kauflimit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is placing this order. It counts against your monthly purchase limit."
          }
        }
      }
    },
    "JARVIS is planning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS يخطّط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS plant"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is planning"
          }
        }
      }
    },
    "JARVIS is ready": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS جاهز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ist bereit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is ready"
          }
        }
      }
    },
    "JARVIS is running its offline rules engine. It handles simple, well-defined requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل JARVIS بمحرّك القواعد دون اتصال، وهو يتعامل مع الطلبات البسيطة والمحدّدة بوضوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS nutzt seine Offline-Regel-Engine. Sie bearbeitet einfache, klar umrissene Anfragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is running its offline rules engine. It handles simple, well-defined requests."
          }
        }
      }
    },
    "JARVIS is using its offline rules engine for simple, well-defined requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS محرّك القواعد دون اتصال للطلبات البسيطة والمحدّدة بوضوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS nutzt für einfache, klar umrissene Anfragen seine Offline-Regel-Engine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is using its offline rules engine for simple, well-defined requests."
          }
        }
      }
    },
    "JARVIS is waiting for your approval": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ينتظر موافقتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS wartet auf deine Freigabe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is waiting for your approval"
          }
        }
      }
    },
    "JARVIS is working": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS يعمل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS arbeitet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is working"
          }
        }
      }
    },
    "JARVIS is working, %@ done": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS يعمل، اكتمل %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS arbeitet, %@ erledigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS is working, %@ done"
          }
        }
      }
    },
    "JARVIS isn't configured": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS غير مُهيّأ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ist nicht eingerichtet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS isn't configured"
          }
        }
      }
    },
    "JARVIS isn't configured on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS غير مُهيّأ على هذا الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS ist auf diesem iPhone nicht eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS isn't configured on this iPhone."
          }
        }
      }
    },
    "JARVIS isn't watching any email threads. Ask it to tell you when someone replies to a message it sent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتابع JARVIS أي سلسلة رسائل. اطلب منه أن يخبرك عندما يردّ أحد على رسالة أرسلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS beobachtet keine Unterhaltungen. Bitte JARVIS, dir Bescheid zu sagen, wenn jemand auf eine von ihm gesendete Nachricht antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS isn't watching any email threads. Ask it to tell you when someone replies to a message it sent."
          }
        }
      }
    },
    "JARVIS keeps exactly this text. You can delete it in Memory later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ JARVIS بهذا النص كما هو تمامًا، ويمكنك حذفه لاحقًا في الذاكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS behält genau diesen Text. Du kannst ihn später unter „Gedächtnis“ löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS keeps exactly this text. You can delete it in Memory later."
          }
        }
      }
    },
    "JARVIS left that text out of the summary.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبعد JARVIS هذا النص من الملخص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat diesen Text nicht in die Zusammenfassung übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS left that text out of the summary."
          }
        }
      }
    },
    "JARVIS needs microphone access to hear your request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج JARVIS إلى الوصول إلى الميكروفون ليسمع طلبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS braucht Zugriff auf das Mikrofon, um deine Anfrage zu hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS needs microphone access to hear your request."
          }
        }
      }
    },
    "JARVIS needs speech recognition access to turn your voice into text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج JARVIS إلى الوصول إلى التعرّف على الكلام لتحويل صوتك إلى نص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS braucht Zugriff auf die Spracherkennung, um deine Stimme in Text umzuwandeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS needs speech recognition access to turn your voice into text."
          }
        }
      }
    },
    "JARVIS performs exactly the action shown": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينفّذ JARVIS الإجراء المعروض تمامًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS führt genau die angezeigte Aktion aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS performs exactly the action shown"
          }
        }
      }
    },
    "JARVIS runs it again from the step that didn't finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد JARVIS تشغيلها بدءًا من الخطوة التي لم تكتمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS führt sie ab dem Schritt erneut aus, der nicht abgeschlossen wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS runs it again from the step that didn't finish."
          }
        }
      }
    },
    "JARVIS sees this conversation's earlier requests and results. It treats results as information, never as instructions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى JARVIS الطلبات والنتائج السابقة في هذه المحادثة، ويتعامل مع النتائج على أنها معلومات لا تعليمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sieht die früheren Anfragen und Ergebnisse dieses Gesprächs. Ergebnisse gelten als Information, nie als Anweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sees this conversation's earlier requests and results. It treats results as information, never as instructions."
          }
        }
      }
    },
    "JARVIS sent a response this version of the app can't read. Update the app or try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل JARVIS ردًا لا يستطيع هذا الإصدار من التطبيق قراءته. حدّث التطبيق أو حاول لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat eine Antwort gesendet, die diese App-Version nicht lesen kann. Aktualisiere die App oder versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sent a response this version of the app can't read. Update the app or try again later."
          }
        }
      }
    },
    "JARVIS still asks you before every purchase and shows the exact items, total, merchant and delivery. It never buys more than this in a month.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظل JARVIS يسألك قبل كل عملية شراء ويعرض المنتجات والمبلغ الإجمالي والتاجر والتوصيل بدقة. ولن يشتري أبدًا بأكثر من هذا المبلغ في الشهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS fragt dich trotzdem vor jedem Kauf und zeigt die genauen Artikel, den Gesamtbetrag, den Händler und die Lieferung. Es kauft nie mehr als diesen Betrag im Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS still asks you before every purchase and shows the exact items, total, merchant and delivery. It never buys more than this in a month."
          }
        }
      }
    },
    "JARVIS stops before its next step. Steps that already finished are not undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف JARVIS قبل خطوته التالية. لا يتم التراجع عن الخطوات التي اكتملت بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS stoppt vor dem nächsten Schritt. Bereits abgeschlossene Schritte werden nicht rückgängig gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS stops before its next step. Steps that already finished are not undone."
          }
        }
      }
    },
    "JARVIS stops running “%@”. Tasks it already created stay in your history.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوقف JARVIS عن تنفيذ «%@». تبقى المهام التي أنشأها في سجلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS führt „%@“ nicht mehr aus. Bereits erstellte Aufgaben bleiben im Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS stops running “%@”. Tasks it already created stay in your history."
          }
        }
      }
    },
    "JARVIS tells you when someone replies, until %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيخبرك JARVIS عندما يردّ أحد، حتى %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS sagt dir bis %@ Bescheid, wenn jemand antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS tells you when someone replies, until %@."
          }
        }
      }
    },
    "JARVIS took too long to respond. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق JARVIS وقتًا طويلًا للرد. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat zu lange gebraucht. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS took too long to respond. Try again."
          }
        }
      }
    },
    "JARVIS used an isolated browser that keeps nothing between visits, and stops at CAPTCHAs and sign-ins instead of working around them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم JARVIS متصفحًا معزولًا لا يحتفظ بشيء بين الزيارات، ويتوقف عند اختبارات CAPTCHA وتسجيلات الدخول بدلًا من التحايل عليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS hat einen isolierten Browser verwendet, der zwischen Besuchen nichts speichert und bei CAPTCHAs und Anmeldungen anhält, statt sie zu umgehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS used an isolated browser that keeps nothing between visits, and stops at CAPTCHAs and sign-ins instead of working around them."
          }
        }
      }
    },
    "JARVIS uses the language you choose for it in iOS Settings, so it can differ from your iPhone's language. Tap to change it there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS اللغة التي تختارها له في إعدادات iOS، لذا قد تختلف عن لغة الـ iPhone. اضغط لتغييرها هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS verwendet die Sprache, die du dafür in den iOS-Einstellungen wählst – sie kann von der Sprache deines iPhone abweichen. Tippe, um sie dort zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS uses the language you choose for it in iOS Settings, so it can differ from your iPhone's language. Tap to change it there."
          }
        }
      }
    },
    "JARVIS uses these to personalise its work. Delete anything you don't want it to know.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم JARVIS هذه المعلومات لتخصيص عمله. احذف أي شيء لا تريده أن يعرفه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS nutzt sie, um seine Arbeit auf dich abzustimmen. Lösche alles, was JARVIS nicht wissen soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS uses these to personalise its work. Delete anything you don't want it to know."
          }
        }
      }
    },
    "JARVIS will no longer read or change anything in %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يقرأ JARVIS أي شيء في %@ أو يغيّره بعد الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS wird in %@ nichts mehr lesen oder ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS will no longer read or change anything in %@."
          }
        }
      }
    },
    "JARVIS's background worker isn't responding, so new tasks may wait in the queue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستجيب خدمة JARVIS في الخلفية، لذا قد تنتظر المهام الجديدة في قائمة الانتظار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst von JARVIS antwortet nicht, daher können neue Aufgaben in der Warteschlange warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JARVIS's background worker isn't responding, so new tasks may wait in the queue."
          }
        }
      }
    },
    "Keep": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإبقاء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep"
          }
        }
      }
    },
    "Keep it running": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة التشغيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterlaufen lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it running"
          }
        }
      }
    },
    "Keep memories": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بالذكريات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep memories"
          }
        }
      }
    },
    "Keep task history": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بسجل المهام"
          }
