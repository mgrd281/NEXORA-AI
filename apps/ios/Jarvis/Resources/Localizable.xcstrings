    "This build has no API address. Set JARVIS_API_BASE_URL in the build configuration.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الإصدار على عنوان API. عيّن JARVIS_API_BASE_URL في إعدادات البناء."
          }
        },
        "de": {
          "stringUnit": {
