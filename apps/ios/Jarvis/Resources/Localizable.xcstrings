    "error.reason.BOT_PROTECTION": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحظر %@ الزيارات الآلية. لا يتحايل JARVIS على ذلك: تابع على الموقع بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blockiert automatisierte Besuche. JARVIS umgeht das nicht: Mach selbst auf der Website weiter."
