          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your monthly AI budget is set to $0."
          }
        }
      }
    },
    "error.reason.CALENDAR_CONFLICT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الوقت محجوز بالفعل في تقويمك، لذا لم يُضف JARVIS شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dieser Zeit ist in deinem Kalender schon etwas eingetragen, daher hat JARVIS nichts eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That time is already taken in your calendar, so JARVIS didn't add anything."
          }
