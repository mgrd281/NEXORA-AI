        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is binding with the site"
          }
        }
      }
    },
    "This is binding with the site (for example, cancellation fees may apply).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا مُلزِم تجاه الموقع (مثلًا قد تُطبَّق رسوم إلغاء)."
          }
        },
        "de": {
          "stringUnit": {
