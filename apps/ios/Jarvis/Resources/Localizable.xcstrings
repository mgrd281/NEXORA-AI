          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File storage isn't reachable right now. Try again in a moment."
          }
        }
      }
    },
    "error.api.TOO_MANY_ATTACHMENTS": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إرفاق %@ ملفات كحد أقصى بالطلب الواحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
