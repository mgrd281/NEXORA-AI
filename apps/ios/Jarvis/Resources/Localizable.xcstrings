    "I didn't catch that. Try again, or close this and type your request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ألتقط ذلك. حاول مرة أخرى، أو أغلق هذه النافذة واكتب طلبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das habe ich nicht verstanden. Versuche es erneut oder schließe dies und tippe deine Anfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't catch that. Try again, or close this and type your request."
          }
        }
      }
    },
    "In progress": {
      "localizations": {
        "ar": {
