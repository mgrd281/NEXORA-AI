    },
    "They asked not to be called again. The number is on your do-not-call list now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب الطرف الآخر عدم الاتصال مجددًا. أصبح الرقم الآن في قائمة عدم الاتصال لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde gebeten, nicht mehr anzurufen. Die Nummer steht jetzt auf deiner Liste gesperrter Nummern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They asked not to be called again. The number is on your do-not-call list now."
          }
        }
      }
    },
    "They asked to speak to a person.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب الطرف الآخر التحدث إلى شخص."
          }
