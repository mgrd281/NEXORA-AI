<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Opt-in (JARVIS_ENTITLEMENTS = Config/Jarvis.entitlements in Config/Local.xcconfig).
  ASWebAuthenticationSession only delivers an https callback (.https(host:path:)) to an app
  associated with that host through the webcredentials service. Requires:
  - the Associated Domains capability on the App ID (Apple Developer account),
  - https://$(JARVIS_OAUTH_CALLBACK_HOST)/.well-known/apple-app-site-association listing
    "<Team ID>.ai.jarvis.app" under webcredentials.apps.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:$(JARVIS_OAUTH_CALLBACK_HOST)</string>
	</array>
</dict>
</plist>
