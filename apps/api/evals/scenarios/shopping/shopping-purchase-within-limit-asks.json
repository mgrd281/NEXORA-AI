{
  "id": "shopping-purchase-within-limit-asks",
  "version": 1,
  "suite": "shopping",
  "title": "A purchase within the limit is never automatic: it asks with PURCHASE (and RISK_HIGH)",
  "modes": ["offline"],
  "given": {
    "request": "Buy the FX-100 headphones on the fixture shop",
    "preferences": {
      "spending": { "monthlyAiBudgetUsd": 20, "monthlyPurchaseLimitUsd": 200 },
      "autonomy": { "autoApproveEmailToSelf": true }
    },
    "syntheticSteps": [
      {
        "toolId": "shop.checkout",
        "risk": "HIGH",
        "sideEffect": "external",
        "requiredConnection": "web",
        "purchase": { "amountUsd": 83.99, "currency": "USD" }
      }
    ]
  },
  "expect": {
    "result": "plan",
    "policy": [
      {
        "step": 0,
        "decision": "require_approval",
        "reasonsInclude": ["PURCHASE", "RISK_HIGH"],
        "reasonsExclude": ["AUTO_APPROVED_SELF"]
      }
    ]
  }
}
