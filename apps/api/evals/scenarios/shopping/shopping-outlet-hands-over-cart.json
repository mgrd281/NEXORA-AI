{
  "id": "shopping-outlet-hands-over-cart",
  "version": 1,
  "suite": "shopping",
  "title": "A shop whose recipe cannot order: the plan ends with the prepared cart (handed over), no checkout step",
  "modes": ["offline"],
  "given": {
    "request": "Buy 2 FX-10 earbuds on Fixture Outlet",
