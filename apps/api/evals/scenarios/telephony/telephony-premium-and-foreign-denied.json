{
  "id": "telephony-premium-and-foreign-denied",
  "version": 1,
  "suite": "telephony",
  "title": "Telephony — premium-rate numbers and countries the server does not call are refused (toll fraud)",
  "modes": ["offline"],
  "given": {
    "request": "اتصل بالرقم +49 900 1234567",
    "account": { "email": "owner@eval.test", "locale": "ar", "timeZone": "Europe/Berlin" },
    "telephony": { "allowedCountries": ["DE"] },
    "syntheticSteps": [
      {
        "toolId": "phone.call",
        "risk": "MEDIUM",
        "sideEffect": "external",
        "call": { "to": "+499001234567" }
      },
      {
        "toolId": "phone.call",
        "risk": "MEDIUM",
        "sideEffect": "external",
        "call": { "to": "+442079460958" }
      }
    ]
  },
  "expect": {
    "result": "deny",
    "errorReason": "CALL_DESTINATION_BLOCKED",
    "policy": [
      { "step": 0, "decision": "deny", "reasonsInclude": ["CALL_DESTINATION_BLOCKED"] },
      { "step": 1, "decision": "deny", "reasonsInclude": ["CALL_DESTINATION_BLOCKED"] }
    ]
  }
}
