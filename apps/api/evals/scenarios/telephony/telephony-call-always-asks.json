{
  "id": "telephony-call-always-asks",
  "version": 1,
  "suite": "telephony",
  "title": "Telephony — every call is approved first (PHONE_CALL, never automatic), recording and shared details named",
  "modes": ["offline"],
  "given": {
    "request": "Call my dentist on +49 30 12345678 and ask whether they have an appointment free on Tuesday",
    "account": { "email": "owner@eval.test", "locale": "en", "timeZone": "Europe/Berlin" },
    "preferences": { "autonomy": { "autoApproveEmailToSelf": true } },
    "telephony": { "allowedCountries": ["DE"] },
    "syntheticSteps": [
      {
        "toolId": "phone.call",
        "risk": "MEDIUM",
        "sideEffect": "external",
        "call": { "to": "+493012345678" }
      },
      {
        "toolId": "phone.call",
        "risk": "MEDIUM",
        "sideEffect": "external",
        "call": { "to": "+493012345678", "recording": "if_consented", "sharedDetails": 2 }
      }
    ]
  },
  "expect": {
    "result": "plan",
    "policy": [
      {
        "step": 0,
        "decision": "require_approval",
        "reasonsInclude": ["PHONE_CALL", "RISK_MEDIUM"],
        "reasonsExclude": ["AUTO_APPROVED_SELF"]
      },
      {
        "step": 1,
        "decision": "require_approval",
        "reasonsInclude": ["PHONE_CALL", "CALL_RECORDING", "CALL_PERSONAL_INFO"]
      }
    ]
  }
}
