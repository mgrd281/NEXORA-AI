{
  "id": "spec-08-expired-connection",
  "version": 3,
  "suite": "spec",
  "title": "Spec 8 / scenario 9 — expired OAuth credentials: a step that needs the expired Google connection is denied with CONNECTION_EXPIRED (Reconnect), nothing runs",
  "modes": ["offline", "pipeline"],
  "given": {
    "request": "Summarize my unread emails",
    "connections": ["web", "google"],
    "connectionStatus": {
      "google": "expired"
    },
    "connectionCapabilities": {
      "google": ["mail.read"]
    }
  },
  "expect": {
    "result": "deny",
    "errorReason": "CONNECTION_EXPIRED",
    "policy": [
      {
        "step": 0,
        "decision": "deny",
        "reasonsInclude": ["CONNECTION_EXPIRED"]
      }
    ],
    "sideEffectsAtMost": 0,
    "pipeline": {
      "status": "FAILED",
      "errorReason": "CONNECTION_EXPIRED",
      "sideEffectsExactly": 0
    }
  }
}
