{
  "id": "followup-email-it-to-me-en",
  "version": 1,
  "suite": "followup",
  "title": "\"Email it to me\" after a summary sends that summary to me",
  "modes": ["offline", "pipeline"],
  "requires": ["service:followUp"],
  "given": {
    "request": "Email it to me",
    "conversation": [
      {
        "request": "Summarize {{site}}/article",
        "outcome": "answer",
        "resultText": "Renewable sources generated more electricity than coal across Europe for the first time this year."
      }
    ],
    "pages": {
      "{{site}}/article": "article.html"
    },
    "approve": "all"
  },
  "expect": {
    "result": "plan",
    "toolSequence": ["conversation.recall", "email.send"],
    "recipientsExactly": ["{{me}}"],
    "policy": [
      {
        "step": 1,
        "decision": "require_approval",
        "reasonsInclude": ["RECIPIENT_SELF"]
      }
    ],
    "pipeline": {
      "status": "COMPLETED",
      "sideEffectsExactly": 1
    }
  }
}
