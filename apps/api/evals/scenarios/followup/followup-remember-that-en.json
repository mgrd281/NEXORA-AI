{
  "id": "followup-remember-that-en",
  "version": 1,
  "suite": "followup",
  "title": "\"Remember that\" saves the earlier result, after approving the exact text",
  "modes": ["offline", "pipeline"],
  "requires": ["service:followUp"],
  "given": {
    "request": "Remember that",
    "conversation": [
      {
        "request": "Summarize {{site}}/article",
        "outcome": "answer",
        "resultText": "Renewable sources generated more electricity than coal across Europe for the first time this year."
      }
    ],
    "pages": {
      "{{site}}/article": "article.html"
    },
    "approve": "all"
  },
  "expect": {
    "result": "plan",
    "toolSequence": ["conversation.recall", "memory.save"],
    "policy": [
      {
        "step": 1,
        "decision": "require_approval",
        "reasonsInclude": ["MEMORY_FROM_CONTENT"]
      }
    ],
    "pipeline": {
      "status": "COMPLETED",
      "executions": {
        "memory.save": 1
      }
    }
  }
}
