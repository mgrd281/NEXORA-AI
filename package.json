{
  "name": "jarvis",
  "private": true,
  "description": "JARVIS — a secure, multi-platform personal AI agent platform.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @jarvis/api --filter @jarvis/web run /^dev(:worker)?$/",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @jarvis/api test:integration",
    "e2e": "pnpm --filter @jarvis/web e2e",
    "tokens:build": "pnpm --filter @jarvis/tokens build",
    "openapi": "pnpm --filter @jarvis/api openapi",
    "db:setup": "bash scripts/db-setup.sh",
    "db:migrate": "pnpm --filter @jarvis/api db:migrate"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
