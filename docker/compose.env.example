# Environment for docker-compose.yml (local full stack). Copy to the repository root as .env:
#
#   cp docker/compose.env.example .env
#
# .env is git-ignored — never commit it. Generate every secret; do not reuse these examples.
# Use URL-safe passwords (they are embedded in database URLs), e.g.: openssl rand -hex 24

# --- Required -------------------------------------------------------------------------------

# Superuser of the postgres container (used only by its first-start init script).
POSTGRES_PASSWORD=
# Database roles created on first start (docker/postgres/init/10-jarvis-roles.sh):
# jarvis_owner runs migrations; jarvis_app is the runtime role (RLS enforced).
# Changing these later requires ALTER ROLE ... PASSWORD (or `docker compose down -v`, which
# deletes all data).
JARVIS_DB_OWNER_PASSWORD=
JARVIS_DB_APP_PASSWORD=
# 32 random bytes, base64. Encrypts connection secrets (e.g. SMTP passwords) at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# --- Optional -------------------------------------------------------------------------------

# Key id stored with each sealed secret; change it when you rotate the key.
SECRET_ENCRYPTION_KEY_ID=k1
# Without a key JARVIS runs its offline rules planner and says so in the UI.
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_BALANCED=claude-sonnet-5-5
MODEL_DEEP=claude-opus-5-5

LOG_LEVEL=info
SESSION_TTL_DAYS=30
APPROVAL_TTL_HOURS=24
WORKER_CONCURRENCY=4

# Host ports (published on 127.0.0.1 only). WEB_PORT also sets the API's WEB_ORIGIN.
WEB_PORT=3000
API_PORT=4000
FIXTURE_PORT=4599
# 5433 avoids clashing with a PostgreSQL already running on the host.
POSTGRES_PORT=5433
