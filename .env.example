# Copy to apps/api/.env (and keep it out of git). Values below are for local development.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Runtime role (RLS enforced) and migration/owner role. See scripts/db-setup.sh.
DATABASE_URL=postgresql://jarvis_app:jarvis_app_dev@localhost:5432/jarvis
DATABASE_OWNER_URL=postgresql://jarvis_owner:jarvis_owner_dev@localhost:5432/jarvis

WEB_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_ID=k1

# Optional. Without a key JARVIS runs its offline rules planner and says so in the UI.
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_BALANCED=claude-sonnet-5-5
MODEL_DEEP=claude-opus-5-5

# Development only — never set in production (the API refuses to start).
# Lets web.fetch reach local fixture sites, e.g. 127.0.0.1:4599
FETCH_ALLOW_PRIVATE_HOSTS=
# Lets you connect the local dev mailbox (pnpm --filter @jarvis/api dev:mailbox) without TLS.
SMTP_ALLOW_INSECURE_LOCALHOST=false

APPROVAL_TTL_HOURS=24
WORKER_CONCURRENCY=4
