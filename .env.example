# Copy to apps/api/.env (and keep it out of git). Values below are for local development.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Runtime role (RLS enforced) and migration/owner role. See scripts/db-setup.sh.
DATABASE_URL=postgresql://jarvis_app:jarvis_app_dev@localhost:5432/jarvis
DATABASE_OWNER_URL=postgresql://jarvis_owner:jarvis_owner_dev@localhost:5432/jarvis

WEB_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_ID=k1

# Optional. Without a key JARVIS runs its offline rules planner and says so in the UI.
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_BALANCED=claude-sonnet-5-5
MODEL_DEEP=claude-opus-5-5

# Development only — never set in production (the API refuses to start).
# Lets web.fetch reach local fixture sites, e.g. 127.0.0.1:4599
FETCH_ALLOW_PRIVATE_HOSTS=
# Lets you connect the local dev mailbox (pnpm --filter @jarvis/api dev:mailbox) without TLS.
SMTP_ALLOW_INSECURE_LOCALHOST=false

APPROVAL_TTL_HOURS=24
WORKER_CONCURRENCY=4

# --- Phase B (all optional; docs/architecture/phase-b.md §9) ---------------------------------
# Attachment storage: local (development/test), s3 (production), none (uploads unavailable).
# Unset: local outside production, none in production.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.data/attachments
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ENDPOINT=            # S3-compatible services (MinIO, R2); unset for AWS
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=              # e.g. jarvis/
# S3_SSE=AES256           # or aws:kms with S3_SSE_KMS_KEY_ID
# Credentials: the AWS default chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, instance roles).

# Development only (refused in production): local webhook receivers over http, e.g. 127.0.0.1:4700
WEBHOOK_ALLOW_INSECURE_HOSTS=

# Observability: each is off (no overhead) until set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=jarvis-api
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# METRICS_TOKEN=          # at least 24 characters; GET /metrics with Authorization: Bearer <token>
# WORKER_METRICS_PORT=9464  # the worker's own /metrics listener (same token); unset: not served
# WORKER_METRICS_HOST=127.0.0.1

# Worker: how often due schedules become runs (ms, default 15000).
# SCHEDULER_TICK_MS=15000

# --- Phase C (all optional; docs/architecture/phase-c.md §8) ---------------------------------
# OAuth 2.0 clients (authorization code + PKCE, confidential). Without both id and secret the
# provider shows as "not configured on this server". Register the redirect URIs below with it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common          # common | organizations | consumers | <tenant id or domain>
# Exact redirect URIs clients may use (comma-separated). Default: <WEB_ORIGIN>/connections/callback
# OAUTH_REDIRECT_URIS=http://localhost:3000/connections/callback
# Development/test only (refused in production): every Google / Microsoft endpoint on one mock
# origin (tools/mock-providers).
# GOOGLE_BASE_URL_OVERRIDE=http://127.0.0.1:4610
# MICROSOFT_BASE_URL_OVERRIDE=http://127.0.0.1:4611
# Worker: how often threads watched for replies are checked for being due (ms, default 60000).
# EMAIL_WATCH_TICK_MS=60000

# Browser agent: a separate process (pnpm --filter @jarvis/api dev:browser-worker, docs/adr/0017).
# It refuses SECRET_ENCRYPTION_KEY, ANTHROPIC_API_KEY, *_CLIENT_SECRET in production.
# BROWSER_EXECUTABLE_PATH=/opt/pw-browsers/chromium   # default outside production
# BROWSER_WORKER_CONCURRENCY=2
# Development/test only (refused in production): the local fixture site (scripts/fixture-site.mjs)
# BROWSER_FIXTURE_ORIGIN=http://127.0.0.1:4599
# BROWSER_ALLOW_PRIVATE_HOSTS=127.0.0.1:4599
# BROWSER_SITES=fixture-shop,fixture-booking          # default: every recipe whose site is available

# --- Phase D (all optional; docs/architecture/phase-d.md §8) ---------------------------------
# Telephony gateway: Twilio (docs/adr/0020). All three or none; without them phone calls are
# "not configured on this server". The browser worker refuses TWILIO_AUTH_TOKEN in production.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+4930123456789
# Public origin (no path) where Twilio reaches /v1/telephony/… on this API; https in production.
# Webhook signatures (X-Twilio-Signature) are checked against URLs built from it.
# PUBLIC_WEBHOOK_BASE_URL=https://api.example.com
# Development/test only (refused in production): the local mock Twilio (tools/mock-twilio).
# TWILIO_BASE_URL_OVERRIDE=http://127.0.0.1:4620
# Calling window in the callee's time zone, the longest call, calls per account and day.
# CALL_ALLOWED_HOURS=08:00-20:00
# CALL_MAX_SECONDS=300
# CALL_MAX_PER_DAY=10
# Upper bound of the per-minute price (USD) shown as the cost estimate in approvals.
# CALL_PRICE_PER_MINUTE_USD=0.05
# Countries JARVIS may call (default: only the country of TWILIO_FROM_NUMBER). Premium-rate and
# shared-cost numbers are never called.
# CALL_ALLOWED_COUNTRIES=DE,AT,CH
