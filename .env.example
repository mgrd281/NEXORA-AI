# Copy to apps/api/.env (and keep it out of git). Values below are for local development.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Runtime role (RLS enforced) and migration/owner role. See scripts/db-setup.sh.
DATABASE_URL=postgresql://jarvis_app:jarvis_app_dev@localhost:5432/jarvis
DATABASE_OWNER_URL=postgresql://jarvis_owner:jarvis_owner_dev@localhost:5432/jarvis

WEB_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_ID=k1

# Optional. Without a key JARVIS runs its offline rules planner and says so in the UI.
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_BALANCED=claude-sonnet-5-5
MODEL_DEEP=claude-opus-5-5

# Development only — never set in production (the API refuses to start).
# Lets web.fetch reach local fixture sites, e.g. 127.0.0.1:4599
FETCH_ALLOW_PRIVATE_HOSTS=
# Lets you connect the local dev mailbox (pnpm --filter @jarvis/api dev:mailbox) without TLS.
SMTP_ALLOW_INSECURE_LOCALHOST=false

APPROVAL_TTL_HOURS=24
WORKER_CONCURRENCY=4

# --- Phase B (all optional; docs/architecture/phase-b.md §9) ---------------------------------
# Attachment storage: local (development/test), s3 (production), none (uploads unavailable).
# Unset: local outside production, none in production.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.data/attachments
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ENDPOINT=            # S3-compatible services (MinIO, R2); unset for AWS
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=              # e.g. jarvis/
# S3_SSE=AES256           # or aws:kms with S3_SSE_KMS_KEY_ID
# Credentials: the AWS default chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, instance roles).

# Development only (refused in production): local webhook receivers over http, e.g. 127.0.0.1:4700
WEBHOOK_ALLOW_INSECURE_HOSTS=

# Observability: each is off (no overhead) until set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=jarvis-api
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# METRICS_TOKEN=          # at least 24 characters; GET /metrics with Authorization: Bearer <token>
# WORKER_METRICS_PORT=9464  # the worker's own /metrics listener (same token); unset: not served
# WORKER_METRICS_HOST=127.0.0.1

# Worker: how often due schedules become runs (ms, default 15000).
# SCHEDULER_TICK_MS=15000
